---
// src/components/map/MapFilterParent.astro
//
// The filters sidebar: the panel chrome, the per-axis counts each section
// renders, and the one script that turns every control in here into a single
// `mapfilterchange` event. The sections themselves are presentational and read
// their own registries — this file computes counts and owns the wiring.
import { clientProjects } from "~/data/dataCenters";
import { getLegalStatus, isUnderLegalHold } from "~/data/legalStatusMeta";
import { getSizeTier } from "~/data/sizeTierMeta";
import { countBy } from "~/lib/collections";
import { parseMW, projectMW } from "~/lib/projectMetrics";
import FilterHeader from "~/components/filter/FilterHeader.astro";
import FilterLayer from "~/components/filter/FilterLayer.astro";
import FilterFacilities from "~/components/filter/FilterFacilities.astro";
import FilterMoratorium from "~/components/filter/FilterMoratorium.astro";
import FilterStatus from "~/components/filter/FilterStatus.astro";
import FilterProject from "~/components/filter/FilterProject.astro";
import FilterLegal from "~/components/filter/FilterLegal.astro";
import FilterSize from "~/components/filter/FilterSize.astro";
import PollutionScaleTrigger from "~/components/scale/PollutionScaleTrigger.astro";
import { SlidersHorizontal } from "lucide-astro";

// Takes no props: it read the whole dataset from `clientProjects` even when it
// declared `newsItems` and `errorMessage`, which it never once referenced. The
// news rail is NewsFeedParent's job.

// One O(n) pass per axis rather than a full scan per bucket. `countBy` omits
// empty buckets, so every consumer reads these as partial records and supplies
// its own `?? 0` — which is also what keeps a zero-count status visible in the
// sidebar instead of quietly disappearing from the legend.
const countsByStatus = countBy(clientProjects, (p) => p.status);
const countsByLegalStatus = countBy(clientProjects, getLegalStatus);
const countsByTier = countBy(clientProjects, (p) => getSizeTier(projectMW(p)));

const holdCount = clientProjects.filter(isUnderLegalHold).length;

const largestProjects = [...clientProjects].sort(
  (a, b) => parseMW(b.powerCapacityMW) - parseMW(a.powerCapacityMW),
);

const totalCount = clientProjects.length;

// This page prerenders at build time (see the astro build log's "prerendering
// static routes" step), and `deploy.yml` rebuilds and redeploys on every push
// to main -- so a plain `new Date()` evaluated here bakes in the actual last
// build/deploy time with no manual bookkeeping. It will be wrong only in the
// sense that a code-only deploy (no data change) still bumps it; that's the
// tradeoff for "automatic" over "hand-maintained and therefore stale."
const lastUpdated = new Date().toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<!--
  Desktop: the left rail, unchanged. Phone: the `filters` sheet above
  MobileToolbar.astro — `.mobile-sheet` (global.css) restates the position, so
  the utilities here are the desktop ones only.
-->
<div
  id="map-filters"
  class="mobile-sheet absolute z-10 pointer-events-auto font-sans top-0 bottom-0 left-0 right-auto w-auto md:w-72 bg-panel backdrop-blur-md border border-hair md:border-r md:border-l-0 md:border-t-0 md:border-b-0 shadow-2xl shadow-(color:--shadow-panel) flex flex-col overflow-hidden md:overflow-visible transition-transform duration-300 ease-out translate-x-0 rounded-2xl md:rounded-none"
>
  <!--
    The phone header. It is a title and a readout, not a control: the toolbar's
    Filters tab is what opens and closes this now, so the collapse chevron this
    carried is gone with the collapse it drove.

    It is also where `#mf-count` finally lands. The dispatcher has been writing
    "Showing N of M" into it since it was written and the element did not exist
    anywhere in the markup — so the one number telling a reader their filters
    did something was computed and dropped on the floor on every change.
  -->
  <div
    class="band bg-panel md:hidden w-full flex items-center gap-2.5 px-3.5 py-2.5 min-h-12 border-b border-hair shrink-0"
  >
    <span
      class="flex items-center justify-center w-7 h-7 rounded-lg bg-hover shrink-0"
    >
      <SlidersHorizontal size={14} stroke-width={2} class="text-accent" />
    </span>
    <span class="min-w-0 flex-1">
      <span
        class="block text-[10px] font-bold text-ink uppercase tracking-wider leading-none"
        >Filters</span
      >
      <span id="mf-count" class="block text-[10px] text-ink-4 mt-1 leading-none">
        Showing {totalCount} of {totalCount}
      </span>
    </span>
    <!-- See ~/lib/mobileSheet.ts. -->
    <button
      type="button"
      data-sheet-close
      aria-label="Close filters panel"
      class="w-8 h-8 -mr-1 flex items-center justify-center rounded-full text-ink-3 active:bg-hover transition-colors shrink-0"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <FilterHeader totalCount={totalCount} />

  <div
    id="mf-content"
    class="flex flex-col min-h-0 flex-1 overflow-y-auto hide-scrollbar"
  >
    <!-- The 2040 clean grid tracker used to lead this rail as a sixth section.
         It is the banner over the map now, and the record behind it is the
         modal that banner opens — see CleanGridBar.astro. It left because it
         was invisible here: every section ships closed, so the mandate read as
         one more 10px grey label in a stack of filters. -->

    <FilterStatus countsByStatus={countsByStatus} />

    <FilterSize countsByTier={countsByTier} />

    <FilterLegal
      countsByLegalStatus={countsByLegalStatus}
      holdCount={holdCount}
    />

    <FilterLayer group="climate">
      <!-- Legacy pollution sources — a hand-sourced registry, not a PMTiles
           archive, so it rides in this group's slot the same way
           FilterMoratorium.astro rides in Politics' below. See
           research/facility-pins-spec.md §2.6. -->
      <FilterFacilities />
    </FilterLayer>

    <!-- What a site would sit on top of, and then who decides whether it does.
         The moratorium layer rides in the Politics section's slot: it is the
         same question the city boundaries raise ("whose council?") with the
         answer that council has already given. -->
    <FilterLayer group="politics">
      <FilterMoratorium />
    </FilterLayer>

    <FilterProject largestProjects={largestProjects} />
  </div>

  <div class="shrink-0 px-3.5 py-2 border-t border-hair flex flex-col gap-1.5 items-center">
    <PollutionScaleTrigger />
    <span class="text-[10px] text-ink-4">Last updated: {lastUpdated}</span>
  </div>

  <!-- Desktop pull-tab toggle -->
  <button
    id="mf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="map-filters"
    aria-label="Toggle map filters panel"
    class="hidden md:flex absolute z-40 items-center justify-center bg-panel border border-hair border-l-0 text-ink-3 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50
           top-1/2 right-0 translate-x-full -translate-y-1/2 w-8 h-12 rounded-r-xl"
  >
    <svg
      id="mf-toggle-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      class="transition-transform duration-300 ease-out"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M15 18l-6-6 6-6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script>
  import { clientProjects } from "~/data/dataCenters";
  import { onReady } from "~/lib/domReady";
  import { countVisible, type FilterCriteria } from "~/lib/projectFilters";
  import { readStoredFlag, writeStoredFlag } from "~/lib/storage";
  import { isMobile, onSheetChange } from "~/lib/mobileSheet";
  import { LAYER_SECTION_OPEN_EVENT } from "~/data/mapLayers";

  const STORAGE_KEY = "mapFiltersCollapsed";

  let filterCleanups: (() => void)[] = [];

  function initMapFilters(): void {
    const root = document.getElementById("map-filters");
    if (!root) return;

    while (filterCleanups.length > 0) {
      filterCleanups.pop()?.();
    }

    const countLabel = document.getElementById(
      "mf-count",
    ) as HTMLElement | null;
    const selectAllBtn = document.getElementById("mf-select-all");
    const clearAllBtn = document.getElementById("mf-clear-all");

    const statusCheckboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".mf-checkbox"),
    );

    const sizeCheckboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".mf-size-checkbox"),
    );
    const sizeAllBtn = document.getElementById("mf-size-all");
    const sizeNoneBtn = document.getElementById("mf-size-none");
    const size100PlusBtn = document.getElementById("mf-size-100plus");

    const projectLinks = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".mf-project-link"),
    );
    const legalHoldToggle = document.getElementById(
      "mf-legal-hold-only",
    ) as HTMLInputElement | null;
    const toggleBtn = document.getElementById("mf-toggle") as HTMLButtonElement | null;
    const toggleIcon = document.getElementById("mf-toggle-icon") as SVGElement | null;

    const totalCount = clientProjects.length;

    /** Desktop pull-tab state. Persisted. */
    let collapsed = readStoredFlag(STORAGE_KEY);
    /** Phone only: which sheet the toolbar says is open. */
    let openSheet: string | null = null;

    /**
     * This panel's visibility, at both widths.
     *
     * On a phone it is one of three sheets sharing a slot and the toolbar
     * decides which — so all this does is show or hide, and `hidden` beats the
     * `flex` in the class list because Tailwind emits it later in the utilities
     * layer.
     *
     * There used to be a good deal more here: a mobile collapse with its own
     * chevron and stored flag, a `display` override for when a facility sheet
     * covered this card, a ResizeObserver measuring the card's changing height,
     * and a writer for --map-controls-bottom that lifted MapLibre's zoom stack
     * clear of it. None of it survives the move: this panel no longer sits in
     * that corner, and MobileToolbar.astro — a fixed bar whose height is the
     * same for every panel — is the single writer of that variable now.
     */
    function applyPanelState(): void {
      if (isMobile()) {
        root!.classList.toggle("hidden", openSheet !== "filters");
        return;
      }

      root!.classList.remove("hidden");
      if (collapsed) {
        root!.classList.add("-translate-x-full");
        root!.classList.remove("translate-x-0");
        toggleBtn?.setAttribute("aria-expanded", "false");
        if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
      } else {
        root!.classList.remove("-translate-x-full");
        root!.classList.add("translate-x-0");
        toggleBtn?.setAttribute("aria-expanded", "true");
        if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
      }
    }

    filterCleanups.push(
      onSheetChange((open) => {
        openSheet = open;
        applyPanelState();
      }),
    );

    const handleResize = () => applyPanelState();
    window.addEventListener("resize", handleResize);
    filterCleanups.push(() =>
      window.removeEventListener("resize", handleResize),
    );

    // Exclusive Accordion Logic
    const accordionSections = document.querySelectorAll(
      ".mf-accordion-section",
    );

    /** Close every section. The exclusive accordion's shared step, and what
     *  `openSection` below opens *out of*. */
    const closeAllSections = () => {
      accordionSections.forEach((s) => {
        const t = s.querySelector(
          ".mf-accordion-trigger",
        ) as HTMLButtonElement | null;
        const c = s.querySelector(
          ".mf-accordion-content",
        ) as HTMLElement | null;
        if (t && c) {
          t.setAttribute("aria-expanded", "false");
          c.classList.remove("grid-rows-[1fr]");
          c.classList.add("grid-rows-[0fr]");
          t.querySelector("svg")?.classList.add("-rotate-90");
        }
      });
    };

    // Announced once, the first time a section holding layer toggles is
    // opened. MapParent reads it to start reading the PMTiles archives — see
    // LAYER_SECTION_OPEN_EVENT. Latched because the reads are memoized anyway
    // and there is no reason to keep re-announcing.
    //
    // Matches `.moratorium-layer-toggle` as well as `.environmental-layer-toggle`:
    // Politics' only row is the "Data Center Moratoriums" checkbox, which
    // carries the former class rather than the latter (see
    // FilterMoratorium.astro), but switching it on reads the city-boundaries
    // PMTiles archive exactly like any other overlay toggle — so opening
    // Politics alone should warm it too, not just opening Climate.
    let layerSectionAnnounced = false;
    const announceLayerSection = (section: Element) => {
      if (layerSectionAnnounced) return;
      if (
        !section.querySelector(
          ".environmental-layer-toggle, .moratorium-layer-toggle",
        )
      ) {
        return;
      }
      layerSectionAnnounced = true;
      document.dispatchEvent(new CustomEvent(LAYER_SECTION_OPEN_EVENT));
    };

    const openSection = (section: Element) => {
      const trigger = section.querySelector(
        ".mf-accordion-trigger",
      ) as HTMLButtonElement | null;
      const content = section.querySelector(
        ".mf-accordion-content",
      ) as HTMLElement | null;
      if (!trigger || !content) return;

      closeAllSections();
      trigger.setAttribute("aria-expanded", "true");
      content.classList.remove("grid-rows-[0fr]");
      content.classList.add("grid-rows-[1fr]");
      trigger.querySelector("svg")?.classList.remove("-rotate-90");
      announceLayerSection(section);
    };

    accordionSections.forEach((section) => {
      const trigger = section.querySelector(
        ".mf-accordion-trigger",
      ) as HTMLButtonElement | null;
      const contentWrapper = section.querySelector(
        ".mf-accordion-content",
      ) as HTMLElement | null;

      if (!trigger || !contentWrapper) return;

      const onTriggerClick = () => {
        // Clicking the open section closes it, so this is a toggle rather than
        // a select — hence the read before anything is closed.
        if (trigger.getAttribute("aria-expanded") === "false") {
          openSection(section);
        } else {
          closeAllSections();
        }
      };

      trigger.addEventListener("click", onTriggerClick);
      filterCleanups.push(() =>
        trigger.removeEventListener("click", onTriggerClick),
      );
    });


    /** Desktop pull-tab. The phone's Filters tab lives on the toolbar. */
    const onToggleClick = () => {
      collapsed = !collapsed;
      writeStoredFlag(STORAGE_KEY, collapsed);
      applyPanelState();
    };
    toggleBtn?.addEventListener("click", onToggleClick);
    filterCleanups.push(() =>
      toggleBtn?.removeEventListener("click", onToggleClick),
    );

    function dispatchFilterChange(): void {
      const criteria: FilterCriteria = {
        statuses: checkedValues(statusCheckboxes),
        sizeTiers: checkedValues(sizeCheckboxes),
        legalHoldOnly: legalHoldToggle?.checked ?? false,
      };

      if (countLabel) {
        // Same predicate the map's layer filter is built from, so the
        // label and the visible markers can't disagree.
        const visibleCount = countVisible(clientProjects, criteria);
        countLabel.textContent = `Showing ${visibleCount} of ${totalCount}`;
      }

      document.dispatchEvent(
        new CustomEvent("mapfilterchange", { detail: criteria }),
      );
    }

    function checkedValues(boxes: HTMLInputElement[]): string[] {
      return boxes.filter((cb) => cb.checked).map((cb) => cb.value);
    }

    /**
     * Wires one checkbox group plus its All / None shortcuts. The status and
     * capacity groups behave identically, so the listener bookkeeping lives
     * here once rather than being copy-pasted per group.
     */
    function wireCheckboxGroup(
      boxes: HTMLInputElement[],
      allBtn: HTMLElement | null,
      noneBtn: HTMLElement | null,
    ): void {
      boxes.forEach((checkbox) => {
        const onChange = () => dispatchFilterChange();
        checkbox.addEventListener("change", onChange);
        filterCleanups.push(() =>
          checkbox.removeEventListener("change", onChange),
        );
      });

      const setAll = (checked: boolean) => () => {
        boxes.forEach((cb) => (cb.checked = checked));
        dispatchFilterChange();
      };

      const onAll = setAll(true);
      const onNone = setAll(false);
      allBtn?.addEventListener("click", onAll);
      noneBtn?.addEventListener("click", onNone);
      filterCleanups.push(() => {
        allBtn?.removeEventListener("click", onAll);
        noneBtn?.removeEventListener("click", onNone);
      });
    }

    wireCheckboxGroup(statusCheckboxes, selectAllBtn, clearAllBtn);
    wireCheckboxGroup(sizeCheckboxes, sizeAllBtn, sizeNoneBtn);

    // Not an All/None shortcut, so it doesn't fit wireCheckboxGroup's
    // set-every-box-the-same shape: this leaves Medium and Large checked and
    // unchecks only Small, i.e. "hide everything under 100 MW" without
    // touching the Large-only ("hyperscale" in this dataset's own vocabulary,
    // see sizeTierMeta.ts) threshold at 300 MW.
    const onSize100Plus = () => {
      sizeCheckboxes.forEach((cb) => (cb.checked = cb.value !== "small"));
      dispatchFilterChange();
    };
    size100PlusBtn?.addEventListener("click", onSize100Plus);
    filterCleanups.push(() =>
      size100PlusBtn?.removeEventListener("click", onSize100Plus),
    );

    const onLegalHoldChange = () => dispatchFilterChange();
    legalHoldToggle?.addEventListener("change", onLegalHoldChange);
    filterCleanups.push(() =>
      legalHoldToggle?.removeEventListener("change", onLegalHoldChange),
    );

    projectLinks.forEach((link) => {
      const onProjectClick = () => {
        const name = link.dataset.projectName;
        const project = clientProjects.find((p) => p.name === name);
        if (!project) return;
        document.dispatchEvent(
          new CustomEvent("mapmarkerselect", { detail: { project } }),
        );
      };
      link.addEventListener("click", onProjectClick);
      filterCleanups.push(() =>
        link.removeEventListener("click", onProjectClick),
      );
    });

    applyPanelState();
  }

  onReady(initMapFilters);
</script>