---
// src/components/map/MapParent.astro
import { fetchLocalNews } from "~/lib/newsFeed";
import MapFilterParent from "~/components/map/MapFilterParent.astro";
import NewsFeedParent from "../news/NewsFeedParent.astro";
import MapDetailParent from "~/components/map/MapDetailParent.astro";
import MapDetailCta from "~/components/map/MapDetailCta.astro";
import MapThemeSelector from "~/components/ui/MapThemeSelector.astro";
import CampaignBanner from "~/components/campaign/CampaignBanner.astro";
import CleanGridBar from "~/components/grid/CleanGridBar.astro";
import CleanGridTracker from "~/components/grid/CleanGridTracker.astro";
import MobileToolbar from "~/components/mobile/MobileToolbar.astro";

// One build-time snapshot for the news rail's first paint. Spread rather than
// unpacked, so this call site doesn't re-list the payload's fields by hand.
const news = await fetchLocalNews();
---

<section
  id="map-workspace"
  class="relative w-full h-dvh overflow-hidden bg-canvas"
>
  <MapThemeSelector />

  <MapFilterParent />

  <MapDetailParent />

  <!-- Renders the campaign block into a hidden host; the map script below
       moves that node into a popup over the selected marker. -->
  <MapDetailCta />

  <NewsFeedParent {...news} />

  <!--
    THE TOP-CENTRE STACK, and why the two surfaces in it share one wrapper.

    Both float over the map at the top, centred between the rails, and they
    used to be positioned independently — which is a collision waiting to
    happen, because the width available to them is not generous and neither box
    has a fixed height. CampaignBanner's own note works through the arithmetic:
    the rails take 18rem and 24rem, so `calc(100vw - 50rem)` is the widest a
    centred box can be while clearing both, and below ~1010px the 13rem floor
    means it already overlaps them because there is no width at which it
    wouldn't.

    Stacking them by document flow inside one positioned wrapper — rather than
    giving the bar its own `top-` and hoping — means they cannot overlap each
    other at any width or any wrap. The wrapper carries the position, the
    centring and the clamp; each child carries only its own appearance.

    `pointer-events-none` on the wrapper with `auto` on each child: the gap
    between the two boxes is over live map, and it stays clickable.

    On a phone the wrapper is `contents`, so it disappears from the layout
    entirely and each child keeps the phone behaviour it already had — the bar
    hides itself, and the campaign panel is a `.mobile-sheet` positioned
    `fixed` by global.css, which an ancestor's `contents` cannot affect.
  -->
  <div
    class="contents md:block md:absolute md:top-3 md:left-1/2 md:-translate-x-1/2 md:w-[clamp(13rem,calc(100vw-50rem),28rem)] z-55 pointer-events-none"
  >
    <!-- The 2040 mandate as a headline. The full readout stays in the filters
         rail; this is what makes it visible without a click, and clicking it
         opens that section. See CleanGridBar.astro. -->
    <CleanGridBar />

    <!-- Statewide legislative demands. Page-level and independent of marker
         selection, unlike MapDetailCta above — the two answer different
         questions ("what are we fighting for" vs "what do I do about this
         site"), so they stay separate surfaces. -->
    <CampaignBanner />
  </div>

  <!--
    The record behind the banner: milestones, vintages, the statutory off-ramp
    and the sources. A modal rather than a rail section — see CleanGridTracker
    for why it left the sidebar and why it did not simply get deleted along with
    it. Rendered outside the top-centre stack because a `<dialog>` in the top
    layer is positioned by the UA, not by an ancestor.
  -->
  <CleanGridTracker />

  <!--
    Phone chrome, and the controller for every panel above it. Rendered last so
    its bar and scrim sit over the panels in DOM order as well as by z-index.
    Below 768px only — see ~/lib/mobileSheet.ts for what it owns and what it
    deliberately doesn't.
  -->
  <MobileToolbar />

  <div class="relative w-full h-full">
    <div id="map" class="absolute inset-0 w-full h-full bg-canvas"></div>
  </div>
</section>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { clientProjects } from "~/data/dataCenters";
  import {
    getInitialMapStyleId,
    getMapStyleUrlById,
    isMapStyleDark,
  } from "~/data/mapStyles";
  import { STATUS_HEX } from "~/data/mapStatusMeta";
  import { LEGAL_STATUS_META } from "~/data/legalStatusMeta";
  import {
    CITY_BOUNDARIES_LAYER_ID,
    LAYER_SECTION_OPEN_EVENT,
    MAP_LAYER_META,
  } from "~/data/mapLayers";
  import { onReady } from "~/lib/domReady";
  import { buildPreviewHtml } from "~/lib/mapMarkers";
  import { createOverlayLayers } from "~/lib/overlayLayers";
  import {
    createMoratoriumLayer,
    jurisdictionForFeature,
    moratoriumPopupHtml,
    MORATORIUM_API_KEY,
    MORATORIUM_LAYER_IDS,
    MORATORIUM_TINT,
  } from "~/lib/moratoriumLayer";
  import {
    protectedLandForFeature,
    protectedLandPopupHtml,
    type ProtectedLand,
  } from "~/lib/protectedLands";
  import type { PosturedJurisdiction } from "~/data/moratoriums";
  import {
    DEFAULT_CRITERIA,
    matchesProject,
    toFeatureProps,
    toMapLibreFilter,
    type FilterCriteria,
  } from "~/lib/projectFilters";

  const MINNESOTA_CENTER: [number, number] = [-93.265, 44.9778];
  const MOBILE_ZOOM = 6.8;
  const DESKTOP_ZOOM = 6;
  const MOBILE_BREAKPOINT = 768;

  /**
   * Read per call, not captured once at module scope.
   *
   * Three things below branch on it — whether the campaign block floats in a
   * popup, how far the camera lifts a selected marker, and whether the hover
   * hit-test runs at all — and all three have to follow a rotation or a resized
   * window. Only the initial zoom and MapLibre's `cooperativeGestures` are read
   * once, because both are constructor arguments.
   */
  const isPhone = (): boolean => window.innerWidth < MOBILE_BREAKPOINT;

  const DEFAULT_ZOOM = isPhone() ? MOBILE_ZOOM : DESKTOP_ZOOM;

  /**
   * How far up the screen a selected marker is lifted on a phone, as a
   * fraction of viewport height.
   *
   * The facility sheet covers the bottom of the map there (up to 80dvh), so
   * flying a marker to the centre of the *map container* buries it under the
   * panel that just opened to describe it. This puts it in the strip that
   * stays visible above the sheet. Desktop needs none of it — the detail rail
   * is a side panel and the map's centre is still map.
   */
  const PHONE_SELECT_LIFT = 0.28;

  let mapInstance: maplibregl.Map | null = null;
  let mapCleanups: (() => void)[] = [];

  // Legal-hold ring colour is resolved once into a MapLibre `match`
  // expression instead of being baked per-feature, so the ring restyles
  // on the GPU and the registry stays the only place hexes are defined.
  const LEGAL_RING_COLOR: unknown[] = [
    "match",
    ["get", "legalStatus"],
    ...LEGAL_STATUS_META.filter((m) => m.isHold).flatMap((m) => [
      m.legalStatus,
      m.hex,
    ]),
    "transparent",
  ];

  // Marker size scales with sqrt(MW) so *area* tracks capacity. Defined once
  // and reused by the legal-hold ring and its ripples, which must stay locked
  // to the marker they surround at every zoom level.
  //
  // `scale` is a multiplier, not a fixed pixel padding. A constant padding
  // makes the same ring read as two different effects across the dataset's
  // 5–1900 MW range: +6px around the 6px-radius Oppidan dot is a 2.0x halo,
  // while +6px around the 24px Pine Island dot is a thin 1.25x outline.
  // Scaling keeps the halo visually identical at every site size.
  const MARKER_MIN_R = 6;
  const MARKER_MAX_R = 24;
  // The capacity range the radius ramp spans, in MW: the smallest site on the
  // map and the largest. Named because two things interpolate over it — the
  // MapLibre expression below and `markerRadiusPx` in JS — and a popup offset
  // computed against a different domain than the marker it clears is a bug you
  // only see at one end of the dataset.
  const MARKER_MW_MIN = 5;
  const MARKER_MW_MAX = 1900;

  const radiusExpr = (scale: number): unknown[] => [
    "interpolate",
    ["linear"],
    ["sqrt", ["get", "parsedMW"]],
    Math.sqrt(MARKER_MW_MIN),
    MARKER_MIN_R * scale,
    Math.sqrt(MARKER_MW_MAX),
    MARKER_MAX_R * scale,
  ];

  /** Static warning ring, as a multiple of the marker radius. */
  const RING_SCALE = 1.45;

  // --- Project layer ids ---
  //
  // Named because these strings were repeated as literals in a dozen places,
  // and because three separate things need the *order*: the shared filter
  // expression, the ripple animation, and the overlay controller, which inserts
  // its fills beneath the lowest of them so an overlay never paints over a
  // marker. Bottom-first.
  const MARKER_SOURCE_ID = "data-centers";
  /**
   * The ripple's own copy of the same features, and the reason it exists is a
   * bug rather than a preference.
   *
   * The animation below re-sets `circle-radius` every frame, and that value is
   * data-driven (it interpolates on `parsedMW`). MapLibre treats a data-driven
   * paint value as a *relayout*: `StyleLayer.setPaintProperty` returns
   * `requiresRelayout`, and `Style._updateLayer` then marks the layer's whole
   * source `'reload'` and calls `pause()` on it. Sharing the marker source
   * meant pausing and re-parsing every project tile several times a second for
   * as long as the animation ran — which is to say always.
   *
   * On a warm, fast machine the first parse still lands and nothing looks
   * wrong. On a cold load, or a throttled one, it does not: a tile has no
   * `latestFeatureIndex` until its first parse completes, so
   * `queryRenderedFeatures` answers *nothing* for the marker layer, and the map
   * paints markers that cannot be hovered or clicked. Both handlers are
   * driven by that query. It cleared itself as soon as one parse got through,
   * which is why interacting with the map appeared to fix it.
   *
   * Nothing queries this source — it draws two stroke-only rings — so the churn
   * is now confined to layers where it costs only the work, not correctness.
   */
  const RIPPLE_SOURCE_ID = "data-centers-ripple";
  const RIPPLE_LAYER_IDS = [
    "data-centers-legal-ripple-a",
    "data-centers-legal-ripple-b",
  ];
  const LEGAL_RING_LAYER_ID = "data-centers-legal-ring";
  const MARKER_LAYER_ID = "data-centers-circles";
  const MARKER_LABEL_LAYER_ID = "data-centers-labels";

  /**
   * Every layer drawn from the project source, bottom-first. All of them share
   * one filter expression built from the criteria the sidebar counts with; the
   * legal-hold ring and its ripples additionally restrict to flagged sites so
   * they never paint under a compliant marker.
   */
  const PROJECT_LAYER_IDS = [
    ...RIPPLE_LAYER_IDS,
    LEGAL_RING_LAYER_ID,
    MARKER_LAYER_ID,
    MARKER_LABEL_LAYER_ID,
  ];

  // --- Legal-hold ripple tuning ---
  const RIPPLE_PERIOD_MS = 2600;
  /** Ripple travels from the marker edge out to this multiple of its radius. */
  const RIPPLE_MAX_SCALE = 2.2;
  const RIPPLE_PEAK_OPACITY = 0.55;
  // 30fps is indistinguishable for a 2.6s expansion and halves the number of
  // canvas repaints we ask MapLibre for.
  const RIPPLE_FRAME_MS = 1000 / 30;

  const geoJsonData = {
    type: "FeatureCollection",
    features: clientProjects.map((project, index) => ({
      type: "Feature",
      geometry: {
        type: "Point",
        coordinates: [project.coordinates[1], project.coordinates[0]],
      },
      properties: {
        projectIndex: index,
        color: STATUS_HEX[project.status],
        ...toFeatureProps(project),
      },
    })),
  };

  function initMap(): void {
    const mapElement = document.getElementById("map");
    if (!mapElement) return;

    if (mapInstance) {
      try {
        mapInstance.remove();
      } catch (e) {}
      mapInstance = null;
    }
    while (mapCleanups.length > 0) {
      mapCleanups.pop()?.();
    }

    // Which basemap is loaded right now, kept in step with `mapstylechange`
    // below — the one thing on the map whose colours are tuned against the
    // *basemap's* darkness rather than the site's chrome theme (see
    // `isMapStyleDark`). Per-map, like `criteria`: a fresh `initMap()` run
    // opens on a fresh read of the stored choice rather than carrying over
    // whatever the previous map instance had.
    let currentStyleId = getInitialMapStyleId();

    const map = new maplibregl.Map({
      container: "map",
      // Opens on the user's saved basemap, or the one paired with their
      // saved site theme if they never picked one — so a light-theme
      // visitor never gets a dark basemap on first paint.
      style: getMapStyleUrlById(currentStyleId),
      center: MINNESOTA_CENTER,
      zoom: DEFAULT_ZOOM,
      scrollZoom: true,
      // Added by hand below instead, so it lands *after* the zoom buttons in
      // the bottom-right stack — see the note there.
      attributionControl: false,
      cooperativeGestures: isPhone(),
    });
    mapInstance = map;

    map.addControl(
      new maplibregl.NavigationControl({ showCompass: false }),
      "bottom-right",
    );

    // Credit is a license condition, not a courtesy — OpenStreetMap data is
    // ODbL. `compact` keeps it to a single ⓘ button until clicked, so the
    // obligation is met without spending map on a phone. Overlay credits ride
    // on their own sources (see ~/lib/overlayLayers.ts), so each appears only
    // while that layer is switched on.
    //
    // Added here rather than through the Map constructor's `attributionControl`
    // option on purpose: the constructor adds it before this NavigationControl,
    // which puts it *above* the zoom buttons. The corner container stacks in
    // DOM order and is anchored to its bottom edge, so adding it last is what
    // puts it at the bottom — which is what global.css's gap and
    // --map-ctrl-attrib-height (and MapThemeSelector's offset) assume.
    map.addControl(
      new maplibregl.AttributionControl({
        compact: true,
        customAttribution: [
          '<a href="https://openfreemap.org/" target="_blank" rel="noopener">OpenFreeMap</a>',
          '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
        ],
      }),
      "bottom-right",
    );

    // MapLibre's compact mode initialises *expanded*: `_updateCompact()` adds
    // `maplibregl-compact` and `maplibregl-compact-show` together, so the full
    // credit list is showing on first paint until something minimizes it. The
    // whole point of compact here is to stay out of the way until asked, so
    // collapse it once — removing `maplibregl-compact-show` is exactly what
    // MapLibre's own `_updateCompactMinimize` does.
    //
    // Runs once, guarded: at this moment the control may still be
    // `maplibregl-attrib-empty` (the style hasn't reported its sources yet),
    // in which case the classes aren't on it and the collapse can't land. It
    // is retried on `styledata` until it succeeds, then never again — so
    // toggling an overlay later can't snap the panel shut on someone reading
    // it.
    let attributionCollapsed = false;
    const collapseAttributionOnce = (): void => {
      if (attributionCollapsed) return;
      const el = mapElement.querySelector(
        ".maplibregl-ctrl-attrib.maplibregl-compact",
      );
      if (!el) return;
      el.classList.remove("maplibregl-compact-show");
      attributionCollapsed = true;
    };

    collapseAttributionOnce();
    map.on("styledata", collapseAttributionOnce);

    // Surface tile/source load failures — MapLibre swallows these otherwise.
    map.on("error", (e) => {
      console.error("[MapLibre ERROR]", e.error?.message ?? e, e);
    });

    // Per-map, like every other piece of interaction state below. This was the
    // one that sat at module scope, where it survived a client-side navigation
    // that had already thrown away the map it described.
    let isMarkerSelected = false;
    let previousView: { center: maplibregl.LngLat; zoom: number } | null = null;
    let activePopup: maplibregl.Popup | null = null;
    let hoverStateId: number | null = null;

    // --- Campaign action popup ---
    //
    // The "join the campaign" ask, anchored over the selected marker. Distinct
    // from `activePopup` (the hover preview) in both trigger and lifetime: it
    // opens on *selection*, needs no hover, and stays put until the marker is
    // deselected. Its DOM comes from MapDetailCta.astro and is *moved*, never
    // rebuilt — see that file for why a form in a popup depends on it.
    let campaignPopup: maplibregl.Popup | null = null;
    let selectedProjectIndex: number | null = null;

    const getCampaignBlock = (): HTMLElement | null =>
      document.getElementById("mcta-block");

    /**
     * Marker radius in px for a given capacity — the same interpolation
     * `radiusExpr()` hands MapLibre, evaluated in JS so the popup can clear
     * the marker it belongs to. Capacity here is fixed per feature and the
     * expression doesn't interpolate on zoom, so one value holds at every
     * zoom level.
     */
    const markerRadiusPx = (parsedMW: number): number => {
      const lo = Math.sqrt(MARKER_MW_MIN);
      const hi = Math.sqrt(MARKER_MW_MAX);
      const t = Math.min(Math.max((Math.sqrt(parsedMW) - lo) / (hi - lo), 0), 1);
      return MARKER_MIN_R + t * (MARKER_MAX_R - MARKER_MIN_R);
    };

    /** Returns the block to its hidden host, wherever it currently is — the
     *  popup on desktop, the detail sheet's slot on a phone. Its listeners
     *  survive the move, which is the whole reason the node is reparented
     *  rather than rebuilt. */
    const parkCampaignBlock = (): void => {
      const block = getCampaignBlock();
      if (block) document.getElementById("mcta-host")?.appendChild(block);
    };

    const closeCampaignPopup = (): void => {
      // Nulled *before* remove(), because remove() fires MapLibre's own
      // "close" event — the handler below reads this to tell a programmatic
      // close (already mid-deselect) from the user hitting the X (which still
      // has to trigger one).
      const popup = campaignPopup;
      campaignPopup = null;
      popup?.remove();
      // Unconditional, unlike the popup teardown above: on a phone there is no
      // popup to close and the block is parked in the sheet instead, so an
      // early return when `campaignPopup` was null would strand it there.
      parkCampaignBlock();
    };

    const openCampaignPopup = (
      project: (typeof clientProjects)[number],
      coords: [number, number],
    ): void => {
      const block = getCampaignBlock();
      if (!block) return;

      closeCampaignPopup();

      const context = document.getElementById("mcta-context");
      if (context) {
        // Names the site so the actions below read as being about *this*
        // facility. Nothing here promises a follow-up from us — the block is
        // links out to public processes, by design (see MapDetailCta.astro).
        context.textContent = `Organizing near ${project.name}.`;
      }

      // On a phone, no popup at all.
      //
      // The detail sheet opens on the same selection and covers the bottom of
      // the screen, while this popup anchors over the marker — which the fly-to
      // above has just put near the middle. At `z-index: 51` against the
      // sheet's `z-40` the result was a 286px card floating on top of the panel
      // describing the same facility, with two close affordances for one
      // selection. The block goes into the sheet's own slot instead, below the
      // record it belongs to, and `#mdp-content` being its sibling is what lets
      // it stay there across the next open (see MapDetailParent.astro).
      const ctaSlot = document.getElementById("mdp-cta");
      if (isPhone() && ctaSlot) {
        ctaSlot.appendChild(block);
        return;
      }

      // Clear the marker *and* its legal-hold ring, which is the widest thing
      // drawn at this point — a fixed offset would tuck the popup's tail
      // inside the 24px-radius sites while floating it well clear of the 6px
      // ones. `+ 14` leaves room for the popup's own tip.
      const parsedMW = toFeatureProps(project).parsedMW;
      const offset = markerRadiusPx(parsedMW) * RING_SCALE + 14;

      campaignPopup = new maplibregl.Popup({
        closeButton: true,
        // The map's own click handler drives deselection; letting MapLibre
        // also close on click would tear the form down on the first click
        // inside it.
        closeOnClick: false,
        anchor: "bottom",
        offset: [0, -offset],
        maxWidth: "320px",
        className: "campaign-popup",
      })
        .setLngLat(coords)
        .setDOMContent(block)
        .addTo(map);

      // The popup's own X closes the whole selection, so the sidebar and the
      // map's camera don't drift out of sync with what's on screen.
      campaignPopup.on("close", () => {
        // Only reached on a user-initiated close; closeCampaignPopup() clears
        // the reference first precisely so this doesn't re-enter deselection.
        if (!campaignPopup) return;
        campaignPopup = null;
        parkCampaignBlock();
        document.dispatchEvent(
          new CustomEvent("mapmarkerselect", { detail: null }),
        );
      });
    };

    mapCleanups.push(closeCampaignPopup);

    let criteria: FilterCriteria = { ...DEFAULT_CRITERIA };

    // Everything about the PMTiles overlays — reading each archive, adding its
    // fill and borders, switching it on and off, naming the
    // region under the cursor — lives in ~/lib/overlayLayers.ts. It used to be
    // ~120 lines here, interleaved with the marker layers; see that file for the
    // bug that hid in the interleaving.
    // Three tiers, bottom-first: the PMTiles fills, then the moratorium dots,
    // then the project markers. Each controller is told what it must stay
    // beneath, which is what keeps the stack the same however the visitor
    // happens to click the toggles.
    const moratoriums = createMoratoriumLayer(map, {
      layersAbove: PROJECT_LAYER_IDS,
    });
    // The moratorium tint is handed to the overlay controller rather than
    // drawn by the moratorium layer itself: it shades polygons out of the
    // city-boundaries archive, and that controller already owns that source.
    const overlays = createOverlayLayers(map, {
      layersAbove: [...MORATORIUM_LAYER_IDS, ...PROJECT_LAYER_IDS],
      companions: [MORATORIUM_TINT],
      // A getter, not `isMapStyleDark(currentStyleId)` evaluated here: this
      // object is built once, but `currentStyleId` is reassigned by
      // `handleStyleChange` on every later basemap swap, and the fill needs
      // that later value, not the one at construction time.
      isDarkMap: () => isMapStyleDark(currentStyleId),
    });

    const applyMapFilters = () => {
      const base = toMapLibreFilter(criteria);
      for (const layerId of PROJECT_LAYER_IDS) {
        if (!map.getLayer(layerId)) continue;
        const expr = layerId.startsWith("data-centers-legal")
          ? ["all", base, ["==", ["get", "underLegalHold"], true]]
          : base;
        map.setFilter(layerId, expr as any);
      }
      // A filter change can hide every flagged site — stop burning frames.
      syncRipple();
    };

    // --- Legal-hold ripple animation ---
    //
    // Animating a MapLibre layer means asking for a canvas repaint every
    // frame, so this is gated hard: it runs only while flagged sites are
    // actually visible, only while the tab is in the foreground, and never
    // for users who asked for reduced motion. Two staggered stroke-only
    // circle layers on the *existing* source — no new geometry, no DOM
    // markers (which would reproject on the main thread every frame), and
    // no per-frame GeoJSON re-upload. Each frame updates two paint
    // properties per layer; MapLibre treats that as a uniform change.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let rippleFrame: number | null = null;
    let rippleStart = 0;
    let lastRippleTick = 0;

    const hasVisibleHolds = (): boolean =>
      clientProjects.some((p) =>
        matchesProject(p, { ...criteria, legalHoldOnly: true }),
      );

    const setRippleOpacity = (value: number): void => {
      for (const id of RIPPLE_LAYER_IDS) {
        if (map.getLayer(id)) {
          map.setPaintProperty(id, "circle-stroke-opacity", value);
        }
      }
    };

    const stepRipple = (now: number): void => {
      rippleFrame = requestAnimationFrame(stepRipple);
      if (now - lastRippleTick < RIPPLE_FRAME_MS) return;
      lastRippleTick = now;

      if (!rippleStart) rippleStart = now;
      const elapsed = now - rippleStart;

      RIPPLE_LAYER_IDS.forEach((id, i) => {
        if (!map.getLayer(id)) return;
        // Stagger the two waves half a period apart so the effect reads as
        // continuous rather than as a single blinking ring.
        const phase = i / RIPPLE_LAYER_IDS.length;
        const t = ((elapsed / RIPPLE_PERIOD_MS + phase) % 1 + 1) % 1;
        // Ease-out expansion with a linear fade — the wave slows as it
        // dissolves, which reads as energy dissipating outward.
        const eased = 1 - (1 - t) * (1 - t);
        map.setPaintProperty(
          id,
          "circle-radius",
          radiusExpr(1 + eased * (RIPPLE_MAX_SCALE - 1)) as any,
        );
        map.setPaintProperty(
          id,
          "circle-stroke-opacity",
          (1 - t) * RIPPLE_PEAK_OPACITY,
        );
      });
    };

    function syncRipple(): void {
      const shouldRun =
        !reduceMotion.matches &&
        document.visibilityState === "visible" &&
        hasVisibleHolds();

      if (shouldRun && rippleFrame === null) {
        rippleStart = 0;
        lastRippleTick = 0;
        rippleFrame = requestAnimationFrame(stepRipple);
      } else if (!shouldRun && rippleFrame !== null) {
        cancelAnimationFrame(rippleFrame);
        rippleFrame = null;
        setRippleOpacity(0);
      }
    }

    reduceMotion.addEventListener("change", syncRipple);
    document.addEventListener("visibilitychange", syncRipple);
    mapCleanups.push(() => {
      if (rippleFrame !== null) cancelAnimationFrame(rippleFrame);
      rippleFrame = null;
      reduceMotion.removeEventListener("change", syncRipple);
      document.removeEventListener("visibilitychange", syncRipple);
    });

    const addDataLayer = () => {
      if (!map.getSource(MARKER_SOURCE_ID)) {
        map.addSource(MARKER_SOURCE_ID, {
          type: "geojson",
          data: geoJsonData,
          generateId: true,
        });
      }

      // Same features, second source — see RIPPLE_SOURCE_ID. No `generateId`:
      // feature-state belongs to the marker layer, and nothing here is hovered.
      if (!map.getSource(RIPPLE_SOURCE_ID)) {
        map.addSource(RIPPLE_SOURCE_ID, {
          type: "geojson",
          data: geoJsonData,
        });
      }

      // Ripples sit at the very bottom so they wash out from under the
      // marker rather than over it.
      for (const rippleId of RIPPLE_LAYER_IDS) {
        if (map.getLayer(rippleId)) continue;
        map.addLayer({
          id: rippleId,
          type: "circle",
          source: RIPPLE_SOURCE_ID,
          paint: {
            "circle-color": "rgba(0,0,0,0)",
            "circle-radius": radiusExpr(1) as any,
            "circle-stroke-width": 2,
            "circle-stroke-color": LEGAL_RING_COLOR as any,
            "circle-stroke-opacity": 0,
          },
        } as maplibregl.CircleLayerSpecification);
      }

      // Warning ring sits *below* the marker so only the halo shows.
      if (!map.getLayer(LEGAL_RING_LAYER_ID)) {
        map.addLayer({
          id: LEGAL_RING_LAYER_ID,
          type: "circle",
          source: MARKER_SOURCE_ID,
          paint: {
            "circle-color": "rgba(0,0,0,0)",
            "circle-radius": radiusExpr(RING_SCALE) as any,
            "circle-stroke-width": 2.5,
            "circle-stroke-color": LEGAL_RING_COLOR as any,
            "circle-stroke-opacity": 0.9,
          },
        } as maplibregl.CircleLayerSpecification);
      }

      if (!map.getLayer(MARKER_LAYER_ID)) {
        map.addLayer({
          id: MARKER_LAYER_ID,
          type: "circle",
          source: MARKER_SOURCE_ID,
          paint: {
            "circle-color": ["get", "color"],
            "circle-radius": radiusExpr(1) as any,
            "circle-stroke-width": 2,
            "circle-stroke-color": "#ffffff",
            "circle-opacity": [
              "case",
              ["boolean", ["feature-state", "hover"], false],
              1,
              ["==", ["get", "status"], "rejected"],
              0.4,
              0.85,
            ],
          },
        });
        map.addLayer({
          id: MARKER_LABEL_LAYER_ID,
          type: "symbol",
          source: MARKER_SOURCE_ID,
          layout: {
            "text-field": ["to-string", ["get", "parsedMW"]],
            "text-font": ["Open Sans Bold"],
            "text-size": 10,
            "text-allow-overlap": true,
          },
          paint: {
            "text-color": "#ffffff",
            "text-halo-color": "#000000",
            "text-halo-width": 1.5,
          },
        } as maplibregl.SymbolLayerSpecification);
      }

      applyMapFilters();
      // Both of these insert beneath the layers just added, so they go on
      // after them — and again after every basemap swap, since `setStyle`
      // throws all of this away. Moratoriums first: the overlay fills are told
      // to sit under its dots.
      moratoriums.attachToStyle();
      overlays.attachToStyle();
    };

    map.on("load", () => {
      setTimeout(() => map.resize(), 100);
      addDataLayer();
      // NOT warmed here any more. Reading the four archives' metadata cost
      // every visitor seven range requests to the tile bucket on page load —
      // measured — and the large majority never open a layer section at all.
      // The sidebar announces when someone does; see LAYER_SECTION_OPEN_EVENT.
      // Both things warming buys still land in time, because they happen while
      // the reader is looking at the section they just opened.
    });

    // Read the archives the first time the reader opens a section that offers
    // layer toggles. `warmArchives` is idempotent — the reads are memoized per
    // archive — so a second announcement would be free, but the sidebar latches
    // it anyway.
    const handleLayerSectionOpen = () => overlays.warmArchives();
    document.addEventListener(LAYER_SECTION_OPEN_EVENT, handleLayerSectionOpen);
    mapCleanups.push(() =>
      document.removeEventListener(LAYER_SECTION_OPEN_EVENT, handleLayerSectionOpen),
    );

    const handleStyleChange = (event: Event) => {
      const detail = (event as CustomEvent<{ url: string; id: string }>).detail;
      if (detail?.url) {
        // Recorded before `addDataLayer()` rebuilds the overlay fills below,
        // so `isDarkMap` above answers with the basemap that's *about* to be
        // on screen rather than the one being replaced — this is the one
        // assignment that makes it correct.
        currentStyleId = detail.id;
        // Nothing may touch these layers between here and `style.load`:
        // they belong to the style being replaced.
        moratoriums.detachFromStyle();
        overlays.detachFromStyle();
        map.setStyle(detail.url);
        map.once("style.load", () => {
          addDataLayer();
        });
      }
    };
    document.addEventListener("mapstylechange", handleStyleChange);
    mapCleanups.push(() =>
      document.removeEventListener("mapstylechange", handleStyleChange),
    );

    const handleFilterChange = (event: Event) => {
      // The overlay half of the payload is keyed by each layer's `apiKey`, so
      // it's read through the registry rather than by name.
      const detail = (
        event as CustomEvent<Partial<FilterCriteria> & Record<string, unknown>>
      ).detail;
      if (!detail) return;

      // The event is a partial patch: the sidebar sends the full criteria,
      // the environmental-layer toggles send only their own key.
      if (detail.statuses) criteria.statuses = detail.statuses;
      if (detail.sizeTiers) criteria.sizeTiers = detail.sizeTiers;
      if (typeof detail.legalHoldOnly === "boolean") {
        criteria.legalHoldOnly = detail.legalHoldOnly;
      }

      for (const layer of MAP_LAYER_META) {
        const value = detail[layer.apiKey];
        if (typeof value === "boolean") overlays.setVisible(layer.id, value);
      }

      // One checkbox, three things on the map: every city's plain boundary
      // (so the polygon a moratorium applies across is visible even where no
      // ordinance has been recorded), the posture tint over the cities that
      // have acted, and the labelled dots that name them. `CITY_BOUNDARIES_LAYER_ID`
      // has no toggle of its own — see `manualToggle` in `~/data/mapLayers.ts`.
      const showMoratoriums = detail[MORATORIUM_API_KEY];
      if (typeof showMoratoriums === "boolean") {
        overlays.setVisible(CITY_BOUNDARIES_LAYER_ID, showMoratoriums);
        moratoriums.setVisible(showMoratoriums);
        overlays.setCompanionVisible(MORATORIUM_TINT.id, showMoratoriums);
      }

      applyMapFilters();
    };
    document.addEventListener("mapfilterchange", handleFilterChange);
    mapCleanups.push(() =>
      document.removeEventListener("mapfilterchange", handleFilterChange),
    );

    const handleMarkerSelect = (event: Event) => {
      const detail = (
        event as CustomEvent<{
          project: (typeof clientProjects)[number];
        } | null>
      ).detail;

      if (detail?.project) {
        const project = detail.project;
        const coords: [number, number] = [
          project.coordinates[1],
          project.coordinates[0],
        ];

        if (!isMarkerSelected)
          previousView = { center: map.getCenter(), zoom: map.getZoom() };

        isMarkerSelected = true;
        selectedProjectIndex = clientProjects.indexOf(project);
        map.flyTo({
          center: coords,
          zoom: Math.max(map.getZoom(), 11),
          // Negative y is up the screen: this places the marker above the
          // container's centre so the sheet doesn't open over it. See
          // PHONE_SELECT_LIFT. The deselect below flies back with no offset,
          // which restores the plain centring along with the saved view.
          offset: isPhone()
            ? [0, -window.innerHeight * PHONE_SELECT_LIFT]
            : [0, 0],
          essential: true,
        });
        openCampaignPopup(project, coords);
      } else {
        closeCampaignPopup();
        selectedProjectIndex = null;
        if (isMarkerSelected) {
          isMarkerSelected = false;
          const target = previousView ?? {
            center: MINNESOTA_CENTER,
            zoom: DEFAULT_ZOOM,
          };
          map.flyTo({
            center: target.center,
            zoom: target.zoom,
            essential: true,
          });
          previousView = null;
        }
      }
    };
    document.addEventListener("mapmarkerselect", handleMarkerSelect);
    mapCleanups.push(() =>
      document.removeEventListener("mapmarkerselect", handleMarkerSelect),
    );

    /** Moves the hover feature-state onto one marker, or clears it. The source
     *  name and the "clear the previous one first" step were written out at
     *  three call sites. */
    const setHoveredMarker = (id: number | null): void => {
      if (hoverStateId !== null) {
        map.setFeatureState(
          { source: MARKER_SOURCE_ID, id: hoverStateId },
          { hover: false },
        );
      }
      hoverStateId = id;
      if (id !== null) {
        map.setFeatureState({ source: MARKER_SOURCE_ID, id }, { hover: true });
      }
    };

    map.on("mouseenter", MARKER_LAYER_ID, (e) => {
      map.getCanvas().style.cursor = "pointer";
      if (e.features && e.features.length > 0) {
        setHoveredMarker(e.features[0].id as number);

        const feature = e.features[0];
        // The selected marker already carries the campaign popup at this exact
        // spot — stacking the hover preview on top would cover it the moment
        // the cursor crossed the marker on its way to the form.
        const isSelected =
          feature.properties.projectIndex === selectedProjectIndex;

        if (!isPhone() && !isSelected) {
          if (activePopup) activePopup.remove();
          const project = clientProjects[feature.properties.projectIndex];
          activePopup = new maplibregl.Popup({
            closeButton: false,
            offset: 15,
            // buildPreviewHtml's card is `w-full`, so it exactly fills
            // whatever this leaves after the popup's own 16px padding each
            // side (see .maplibregl-popup-content in global.css) — this used
            // to be 280px against a fixed w-64 (256px) card, 8px too narrow,
            // which shoved the card against the left padding and left it
            // visibly off-center under the tip instead of symmetric.
            maxWidth: "288px",
          })
            .setLngLat(feature.geometry.coordinates as [number, number])
            .setHTML(buildPreviewHtml(project))
            .addTo(map);
        }
      }
    });

    map.on("mouseleave", MARKER_LAYER_ID, () => {
      map.getCanvas().style.cursor = "";
      setHoveredMarker(null);
      if (activePopup) activePopup.remove();
    });

    map.on("click", MARKER_LAYER_ID, (e) => {
      if (!e.features || e.features.length === 0) return;
      if (activePopup) activePopup.remove();

      const feature = e.features[0];
      const project = clientProjects[feature.properties.projectIndex];
      document.dispatchEvent(
        new CustomEvent("mapmarkerselect", { detail: { project } }),
      );
    });

    // --- Overlay hover/tap labels ---
    //
    // One hit test answers both questions these handlers have — "is the cursor
    // on a marker?" and "which overlay region is under it?" — because a single
    // query over the marker layer plus the switched-on overlays returns them
    // topmost-first. It was three `queryRenderedFeatures` calls per pointer
    // event, two of them just to yield to the marker, on a `mousemove` that
    // fires more often than the map draws — while the same main thread was
    // parsing tiles for a layer someone had just switched on.
    //
    // The layer ids come from the controller rather than from a fresh sweep of
    // `map.getLayer`, and they matter: MapLibre fires an error and returns
    // *nothing* if any requested layer isn't in the style.
    let envPopup: maplibregl.Popup | null = null;
    /** Region whose hover card is currently up, so it isn't re-anchored per frame. */
    let hoveredCardKey: string | null = null;

    /**
     * What the pointer is over, resolved once.
     *
     * `idle` and `none` are different answers and the hover handler treats
     * them differently: `idle` means nothing this handler owns is switched on,
     * so it must not touch the cursor at all — the marker layer's own
     * mouseenter/mouseleave own it. `none` means we looked and the pointer is
     * over bare map, which is when a stale label popup has to be cleared.
     *
     * `overlay` is the plain case — a region with a name and nothing else we
     * know about it. `protected` is the one overlay whose archive carries a
     * whole record per polygon, so it gets a card rather than a word.
     */
    type Hit =
      | { kind: "idle" }
      | { kind: "none" }
      | { kind: "marker" }
      | { kind: "moratorium"; jurisdiction: PosturedJurisdiction }
      | { kind: "protected"; site: ProtectedLand }
      | { kind: "overlay"; label: string };

    const IDLE: Hit = { kind: "idle" };
    const NO_HIT: Hit = { kind: "none" };

    /**
     * Is this point on a project marker?
     *
     * Asked by the map-wide click handler below, which has to yield to the
     * marker layer's own handler at *every* overlay state — and this is the one
     * question `hitTest` cannot answer for it. That test returns `idle` before
     * it looks at anything, whenever no overlay is switched on, which is the
     * state the map opens in and the state most visitors never leave.
     *
     * So a marker tap read as a tap on bare map, and MapLibre runs both
     * listeners for one click, in the order they were registered: the marker's
     * handler dispatched the selection, and this handler dispatched a deselect
     * immediately after it. The detail panel opened and shut again, and the
     * camera flew to the site and straight back out.
     *
     * One layer, and only on click, so this doesn't reintroduce the per-frame
     * marker query the hover path was written to avoid.
     */
    const isMarkerAt = (point: maplibregl.Point): boolean =>
      !!map.getLayer(MARKER_LAYER_ID) &&
      map.queryRenderedFeatures(point, { layers: [MARKER_LAYER_ID] }).length > 0;

    const hitTest = (point: maplibregl.Point): Hit => {
      // A town can be reported by either of two layers — the shaded boundary,
      // which belongs to the overlay controller's source, or its name label.
      // Both mean the same thing here.
      const moratoriumIds = [
        ...overlays.visibleCompanionIds(),
        ...moratoriums.visibleLayerIds(),
      ];
      const overlayIds = overlays.visibleLayerIds();
      // Nothing switched on that this test can answer for. The marker layer
      // alone doesn't count: its own handlers cover it, and querying for it
      // here would only duplicate their work on every frame.
      if (moratoriumIds.length === 0 && overlayIds.length === 0) return IDLE;

      const layers = [
        ...(map.getLayer(MARKER_LAYER_ID) ? [MARKER_LAYER_ID] : []),
        ...moratoriumIds,
        ...overlayIds,
      ];

      // Topmost-first, which is also the order these are stacked: markers over
      // the moratorium shading over the plain city fills beneath it.
      const [top] = map.queryRenderedFeatures(point, { layers });
      if (!top) return NO_HIT;
      if (top.layer.id === MARKER_LAYER_ID) return { kind: "marker" };
      if (moratoriumIds.includes(top.layer.id)) {
        const jurisdiction = jurisdictionForFeature(top);
        return jurisdiction ? { kind: "moratorium", jurisdiction } : NO_HIT;
      }
      // Claimed before `regionLabel`, which would answer for this feature with
      // the layer's own label — the words "Protected Lands" over any of 17,000
      // named places. Returns null for every other overlay's features.
      const site = protectedLandForFeature(top);
      if (site) return { kind: "protected", site };

      const label = overlays.regionLabel(top);
      return label ? { kind: "overlay", label } : NO_HIT;
    };

    /**
     * A hit that opens a *card* rather than a one-word label, plus the key that
     * says whether the card already up is the same one.
     *
     * Cards are placed once, where the pointer entered the region, and left
     * there while it stays inside: something this size re-anchored every frame
     * would shudder across the screen the whole way over a polygon, and unlike
     * a region's name a card is read rather than glanced at.
     *
     * The markup is a thunk because the key alone settles whether it's needed —
     * a protected-lands card is assembled from a parsed attribute table, and
     * building one per frame to throw away is what the key exists to avoid.
     */
    const hoverCard = (hit: Hit): { key: string; html: () => string } | null => {
      if (hit.kind === "moratorium") {
        return {
          key: `moratorium:${hit.jurisdiction.id}`,
          html: () => moratoriumPopupHtml(hit.jurisdiction, "hover"),
        };
      }
      if (hit.kind === "protected") {
        return {
          key: `protected:${hit.site.id}`,
          html: () => protectedLandPopupHtml(hit.site, "hover"),
        };
      }
      return null;
    };

    /**
     * The label bubble, shared by the hover popup and the click popup — which
     * differ only in whether they persist and carry a close button.
     *
     * A node with `textContent`, not an HTML string: the text is a feature
     * attribute out of a PMTiles archive, so it is third-party data being put
     * on the page. CampaignBanner.astro states this policy for the Open States
     * payload ("none of it is ours to trust as markup"); the same applies to a
     * city name from a state GIS export, and building the node is shorter than
     * escaping a template anyway.
     */
    const envLabelNode = (label: string): HTMLElement => {
      const node = document.createElement("strong");
      node.textContent = label;
      return node;
    };

    // Coalesced to one hit test per frame: the last position seen in a frame is
    // the only one that can still be under the cursor when it renders.
    let pendingMove: maplibregl.MapMouseEvent | null = null;
    let moveFrame: number | null = null;

    const handleHover = (): void => {
      moveFrame = null;
      const event = pendingMove;
      pendingMove = null;
      if (!event) return;

      // One hit test per frame, and it also answers "is there anything on that
      // this handler owns" — see the `Hit` union for why `idle` and `none`
      // aren't the same answer.
      const hit = hitTest(event.point);
      const card = hoverCard(hit);
      if (!card) hoveredCardKey = null;
      if (hit.kind === "idle" || hit.kind === "marker") return;

      if (hit.kind === "none") {
        envPopup?.remove();
        envPopup = null;
        map.getCanvas().style.cursor = "";
        return;
      }

      map.getCanvas().style.cursor = "pointer";

      envPopup ??= new maplibregl.Popup({
        closeButton: false,
        closeOnClick: false,
      });

      if (card) {
        if (hoveredCardKey !== card.key) {
          hoveredCardKey = card.key;
          envPopup.setLngLat(event.lngLat).setHTML(card.html()).addTo(map);
        }
        return;
      }

      // A one-word label is cheap enough to follow the cursor, and following it
      // is what makes clear which shape under the pointer is being named.
      if (hit.kind === "overlay") {
        envPopup
          .setLngLat(event.lngLat)
          .setDOMContent(envLabelNode(hit.label))
          .addTo(map);
      }
    };

    map.on("mousemove", (e) => {
      // Nothing downstream of here has an effect on a phone: there is no
      // cursor to restyle and no room for a label that tracks one, so
      // `handleHover` used to run a full `queryRenderedFeatures` over every
      // switched-on overlay and then throw the answer away one line later.
      // Browsers still synthesise mousemove from touch, so this fired on the
      // exact devices least able to afford it.
      if (isPhone()) return;
      pendingMove = e;
      if (moveFrame === null) moveFrame = requestAnimationFrame(handleHover);
    });

    mapCleanups.push(() => {
      if (moveFrame !== null) cancelAnimationFrame(moveFrame);
      moveFrame = null;
      pendingMove = null;
    });

    // One handler for a click anywhere that isn't a marker: clear the selection,
    // and name the overlay region if the tap landed on one. This was two separate
    // listeners that between them ran the same hit-test three times — and, being
    // independent, each had to re-derive "did this land on a marker" for itself.
    map.on("click", (e) => {
      // The marker's own handler owns this tap. Tested directly rather than
      // through `hitTest`, which cannot see markers while every overlay is off
      // — see `isMarkerAt`.
      if (isMarkerAt(e.point)) return;

      const hit = hitTest(e.point);

      document.dispatchEvent(
        new CustomEvent("mapmarkerselect", { detail: null }),
      );

      if (hit.kind === "moratorium" || hit.kind === "protected") {
        // The hover card and the full record at the same spot would stack, and
        // the hover one is the disposable half.
        envPopup?.remove();
        envPopup = null;
        hoveredCardKey = null;

        new maplibregl.Popup({
          closeButton: true,
          maxWidth: "320px",
          // Opts back into the close button global.css hides, the way the
          // campaign popup does — a card that persists until dismissed needs a
          // way to dismiss it, and on a phone there is no hover to leave.
          className: "map-record-popup",
        })
          .setLngLat(e.lngLat)
          .setHTML(
            hit.kind === "moratorium"
              ? moratoriumPopupHtml(hit.jurisdiction, "detail")
              : protectedLandPopupHtml(hit.site, "detail"),
          )
          .addTo(map);
        return;
      }

      if (hit.kind === "overlay") {
        new maplibregl.Popup({ closeButton: true })
          .setLngLat(e.lngLat)
          .setDOMContent(envLabelNode(hit.label))
          .addTo(map);
      }
    });
  }

  onReady(initMap);
</script>