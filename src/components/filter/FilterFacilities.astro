---
// src/components/filter/FilterFacilities.astro
//
// The Pollution Sources section's one row — Minnesota's largest documented
// pollution sources (`~/data/mnPollutionFacilities.ts`), off by default,
// expanding to one checkbox per sector once switched on
// (research/facility-pins-spec.md §2.6). Rendered into `FilterLayer.astro`'s
// `<slot />` for `group="pollution"`, the same mechanism `FilterMoratorium.astro`
// uses for the Politics group — see MapFilterParent.astro for the composition
// point. Originally built inside `group="climate"`'s slot; moved to its own
// top-level group because "who else nearby already pollutes, for comparison"
// isn't the same question Climate & Regional Impacts answers ("what would a
// site sit on top of") — see `~/data/mapLayers.ts`'s `MapLayerGroup` doc
// comment for the three-way distinction.
//
// It is not an `.environmental-layer-toggle`: those are PMTiles archives with
// an unavailable/reload lifecycle this layer structurally cannot have (it's a
// hand-sourced registry, same as the moratorium row) — see
// `~/lib/facilityMarkers.ts`'s header note. It is also not a
// `.moratorium-layer-toggle`: that class exists only to opt one specific row
// out of FilterLayer.astro's per-row unavailable handling. This row needs
// neither wiring, so it gets its own class and its own script block.
//
// THE NEW PART: nothing else in the codebase nests a second level of
// checkboxes inside one accordion row. Checking the master box reveals the
// sector sub-list; unchecking it hides the sub-list AND removes every pin,
// regardless of which sector boxes are individually checked (done criterion
// 2/8) — the sub-boxes' state is preserved while hidden, so re-checking the
// master box restores whatever sectors were on before, rather than resetting
// to "all on."
//
// This is also the accessible DOM record list for facility pins (spec §3
// item 7), kept structurally separate from FilterProject.astro's — see that
// list below the sector checkboxes, and MapParent.astro's
// `FACILITY_LIST_SELECT_EVENT` listener for how activating an entry there
// opens the same record a pointer click on the pin does.
import { ChevronRight, Factory, Mountain, Pickaxe, Flame, TreePine, Fuel, Wheat, Zap } from "lucide-astro";
import { POLLUTION_FACILITIES } from "~/data/mnPollutionFacilities";
import {
  FACILITY_API_KEY,
  FACILITY_SECTOR_SWATCHES,
  FACILITY_SECTORS_API_KEY,
} from "~/lib/facilityMarkers";

const facilitiesBySector = new Map<string, number>();
for (const facility of POLLUTION_FACILITIES) {
  facilitiesBySector.set(facility.sector, (facilitiesBySector.get(facility.sector) ?? 0) + 1);
}

// Per-sector icons, kept here rather than in facilityMarkers.ts, for the
// same reason FilterLayer.astro's own SWATCHES table gives: lucide-astro
// exports Astro components, and importing those into a plain .ts data
// module is the wrong direction. Color alone (the dot next to each row, and
// the pin color on the map) isn't enough to tell two sectors apart for a
// colorblind reader or in a black-and-white printout/screenshot — this is
// the second, non-color channel for the same distinction.
const SECTOR_ICONS: Record<string, typeof Factory> = {
  "Taconite mining/processing": Mountain,
  "Taconite processing": Factory,
  "Taconite mining": Pickaxe,
  "Coal power generation": Flame,
  "Pulp/paper": TreePine,
  "Petroleum refining": Fuel,
  "Sugar mill": Wheat,
  "Electricity generation via combustion": Zap,
};
const FALLBACK_SECTOR_ICON = Factory;

const sortedFacilities = [...POLLUTION_FACILITIES].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="flex flex-col gap-1 px-3.5 md:px-4 py-3 bg-panel-3 border-t border-hair">
  <label
    class="flex items-start gap-3 cursor-pointer group rounded-lg px-2 py-2 transition-colors hover:bg-hover"
  >
    <input
      type="checkbox"
      id="mf-toggle-facilities"
      data-api-key={FACILITY_API_KEY}
      data-sectors-api-key={FACILITY_SECTORS_API_KEY}
      class="facility-layer-toggle mt-0.5 w-3.5 h-3.5 rounded border-hair-strong bg-panel-2 accent-orange-800 dark:accent-orange-400 cursor-pointer"
    />
    <span class="mt-0.5 shrink-0 text-ink-2 group-hover:text-ink transition-colors">
      <Factory size={16} stroke-width={2} />
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-xs font-semibold text-ink-2 group-hover:text-ink transition-colors">
        Facilities — Minnesota's Biggest Known Polluters
      </span>
      <span class="block text-[10px] leading-snug text-ink-4 mt-0.5">
        {POLLUTION_FACILITIES.length} taconite mines, coal plants, oil
        refineries, paper mills, and sugar mills — with real, sourced numbers
        for the climate gases, water use, and air pollution each one is
        documented to produce. See where they sit compared to data centers.
      </span>
    </span>
  </label>

  <!-- Hidden until the master box is checked — an unopened accordion row
       showing eight sector checkboxes nobody asked for yet is noise, the
       same reasoning FilterMoratorium.astro gives its legend. -->
  <div class="hidden mt-1 pl-9" id="mf-facility-sectors">
    <ul class="flex flex-col gap-1">
      {
        FACILITY_SECTOR_SWATCHES.map(({ sector, swatch }) => {
          const SectorIcon = SECTOR_ICONS[sector] ?? FALLBACK_SECTOR_ICON;
          return (
            <li>
              <label class="flex items-center gap-2 cursor-pointer group rounded-md px-1.5 py-1 transition-colors hover:bg-hover">
                <input
                  type="checkbox"
                  checked
                  value={sector}
                  class="facility-sector-checkbox w-3 h-3 rounded border-hair-strong bg-panel-2 cursor-pointer"
                  style={`accent-color: ${swatch.light}`}
                />
                <span
                  class="shrink-0 w-2 h-2 rounded-full"
                  style={`background-color: ${swatch.light}`}
                  aria-hidden="true"
                />
                <span class="shrink-0" style={`color: ${swatch.light}`} aria-hidden="true">
                  <SectorIcon size={12} stroke-width={2} />
                </span>
                <span class="min-w-0 flex-1 text-[10.5px] font-medium text-ink-2 group-hover:text-ink transition-colors">
                  {sector}
                </span>
                <span class="text-[9.5px] font-bold text-ink-4 tabular-nums">
                  {facilitiesBySector.get(sector) ?? 0}
                </span>
              </label>
            </li>
          );
        })
      }
    </ul>

    <!-- The legend: sector color key (spec §3 item 8). Shown only while the
         layer is on, same gating as the sector checkboxes themselves — it's
         the same list rendered as a key rather than as controls, so one
         source of truth for the palette (`FACILITY_SECTOR_SWATCHES`) draws
         both. -->
    <p class="mt-2 pt-2 border-t border-hair text-[9px] leading-snug text-ink-4">
      Each pin is a colored icon shape (listed above) — the shape and color
      both show the type of facility. Pin size shows how much it could
      affect air quality in nearby parks and wilderness areas — never a
      single "total pollution" number, since that isn't something that can
      honestly be added up across different pollutants. A faded pin means
      that ranking hasn't been calculated for this facility — not that it
      ranks low.
    </p>

    <!-- Accessible DOM record list for facility pins — separate from
         FilterProject.astro's data-center list (spec §3 item 7,
         CLAUDE.md §7). Every facility currently in the registry, always
         listed here regardless of which sector boxes are checked, so a
         screen-reader user can reach a filtered-out facility's record the
         same way a sighted user can still find it by turning its sector back
         on — the list names which sectors are hidden rather than pretending
         those facilities don't exist. -->
    <div class="mt-2 pt-2 border-t border-hair">
      <span class="block text-[9px] font-bold uppercase tracking-wider text-ink-4 mb-1">
        All {sortedFacilities.length} sites
      </span>
      <ul
        id="mf-facility-list"
        class="max-h-48 overflow-y-auto hide-scrollbar space-y-0.5"
        aria-label="Documented pollution source facilities"
      >
        {
          sortedFacilities.map((facility) => (
            <li>
              <button
                type="button"
                data-facility-id={facility.facilityId}
                data-facility-sector={facility.sector}
                class="mf-facility-link flex items-center justify-between w-full px-2 py-1.5 rounded-md hover:bg-hover transition-colors text-left group"
              >
                <span class="min-w-0 flex flex-col">
                  <span class="text-[11px] font-medium text-ink-2 truncate">
                    {facility.name}
                  </span>
                  <span class="text-[9px] text-ink-4 group-hover:text-ink-2">
                    {facility.sector} — {facility.county} County
                  </span>
                  <!-- Hidden by default; the script below shows this whenever
                       this facility's sector is currently unchecked, so the
                       list actually delivers on the promise above instead of
                       silently listing facilities a sighted user can't see
                       pinned on the map right now. Found in review. -->
                  <span
                    class="mf-facility-hidden-note hidden text-[9px] italic text-ink-4 mt-0.5"
                  >
                    Not currently shown on the map — its sector is unchecked above.
                  </span>
                </span>
                <ChevronRight
                  size={14}
                  class="text-ink-4 group-hover:text-ink shrink-0 ml-2"
                />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  import { onReady } from "~/lib/domReady";
  import { FACILITY_LIST_SELECT_EVENT } from "~/lib/facilityMarkers";

  let facilityCleanups: (() => void)[] = [];

  function setupFacilityToggle(): void {
    while (facilityCleanups.length > 0) {
      facilityCleanups.pop()?.();
    }

    const master = document.getElementById(
      "mf-toggle-facilities",
    ) as HTMLInputElement | null;
    const sectorPanel = document.getElementById("mf-facility-sectors");
    const sectorBoxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".facility-sector-checkbox"),
    );
    const facilityLinks = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".mf-facility-link"),
    );
    if (!master) return;

    // Makes the accessible list actually deliver on its own stated promise
    // (see the header comment above the <ul> in the markup): a facility
    // whose sector is unchecked stays listed, but now says so, instead of
    // silently reading as available when a sighted user can't see its pin.
    // Found in review — this indicator didn't previously exist despite the
    // markup's comment already claiming it did.
    const syncHiddenNotes = (): void => {
      const checkedSectors = new Set(
        sectorBoxes.filter((box) => box.checked).map((box) => box.value),
      );
      for (const link of facilityLinks) {
        const sector = link.dataset.facilitySector;
        const visible = !!sector && checkedSectors.has(sector);
        const note = link.querySelector<HTMLElement>(".mf-facility-hidden-note");
        note?.classList.toggle("hidden", visible);
      }
    };

    const dispatch = (): void => {
      const apiKey = master.dataset.apiKey;
      const sectorsApiKey = master.dataset.sectorsApiKey;
      if (!apiKey || !sectorsApiKey) return;

      document.dispatchEvent(
        new CustomEvent("mapfilterchange", {
          detail: {
            [apiKey]: master.checked,
            [sectorsApiKey]: sectorBoxes
              .filter((box) => box.checked)
              .map((box) => box.value),
          },
        }),
      );
      syncHiddenNotes();
    };

    const onMasterChange = () => {
      // Sub-checkbox state is left alone — hiding the panel doesn't uncheck
      // anything, so re-checking the master box restores whichever sectors
      // were on before rather than resetting to "all on" (see file header).
      sectorPanel?.classList.toggle("hidden", !master.checked);
      dispatch();
    };
    master.addEventListener("change", onMasterChange);
    facilityCleanups.push(() => master.removeEventListener("change", onMasterChange));

    sectorBoxes.forEach((box) => {
      const onSectorChange = () => dispatch();
      box.addEventListener("change", onSectorChange);
      facilityCleanups.push(() => box.removeEventListener("change", onSectorChange));
    });

    // The accessible list's activation path — see facilityMarkers.ts's
    // `FACILITY_LIST_SELECT_EVENT` doc comment for why this is its own event
    // rather than a reuse of `mapmarkerselect`.
    facilityLinks.forEach((link) => {
      const onFacilityClick = () => {
        const facilityId = link.dataset.facilityId;
        if (!facilityId) return;
        document.dispatchEvent(
          new CustomEvent(FACILITY_LIST_SELECT_EVENT, { detail: { facilityId } }),
        );
      };
      link.addEventListener("click", onFacilityClick);
      facilityCleanups.push(() =>
        link.removeEventListener("click", onFacilityClick),
      );
    });
  }

  onReady(setupFacilityToggle);
</script>
