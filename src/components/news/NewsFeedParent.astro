---
// src/components/news/NewsFeedParent.astro
import { formatNewsDate, type NewsPayload } from "~/lib/newsFeed";
import { CloudOff, Newspaper, RefreshCw } from "lucide-astro";

interface Props extends NewsPayload {
  initialDays?: number;
}

const {
  newsItems,
  errorMessage,
  truncated,
  partial,
  stale,
  storedAt,
  initialDays = 7,
} = Astro.props;

// Said once, here, so the server's first paint and the client's re-render
// below can't drift into telling the reader two different things.
//
// Two sentences rather than one, because the two gaps aren't the same gap and
// a reader deciding whether they've seen everything deserves to know which:
// the cap thins the whole range evenly, while a failed search removes a
// specific stretch of it.
const CAP_NOTICE =
  "Google returns at most 100 results per search, and this range hit that limit. These are a sample of the period, not every story in it.";
const PARTIAL_NOTICE =
  "Part of this range couldn't be loaded, so some dates may be missing entirely. Try again shortly.";

/**
 * The outage copy, and the reason it doesn't read like an error.
 *
 * What this state actually means is that one upstream feed is quiet — the map,
 * the filters and the bill tracker are all fine, and nothing the reader did
 * caused it or can fix it. The old treatment was a red panel reading
 * "Error: Google News returned 503.", which hands a member of the public an
 * HTTP status code and implies the site is broken. Both are wrong, and the
 * second is the kind of thing that makes someone close the tab on a map they
 * came to for something else.
 *
 * So: no red, plain language, and an explicit line saying what still works.
 * The status code is kept — someone debugging genuinely wants it — but behind
 * a disclosure, where it informs without alarming.
 */
const OUTAGE_TITLE = "Live headlines are unavailable";
const OUTAGE_BODY =
  "Google News isn't answering our server right now. The map, filters and bill tracker are unaffected.";
/* Reads as a whole sentence on its own, so the age slot after it is a suffix
   the script can leave empty when it can't date the copy. */
const STALE_LEAD = "Live feed unavailable — showing saved headlines";
const STALE_AGE_PREFIX = " from";
const EMPTY_NOTICE = "No new local updates found.";

const notice = truncated ? CAP_NOTICE : partial ? PARTIAL_NOTICE : "";

const RANGE_OPTIONS = [
  { label: "24H", days: 1 },
  { label: "7D", days: 7 },
  { label: "30D", days: 30 },
  { label: "1Y", days: 365 },
];
---

<!--
  One list, both layouts.

  Desktop: the full-height right rail it has always been.

  Phone: the `news` sheet above MobileToolbar.astro — `.mobile-sheet` in
  global.css restates the position, so the desktop utilities below are the only
  ones this element needs. There used to be a second, separate mobile UI here: a
  floating card at the top of the screen containing a snap-scrolling carousel of
  headlines, its own dot indicator, its own auto-rotate timer and its own
  dismiss button. All of it is gone. It existed because a 122px card at the top
  of a phone could only ever show one headline at a time; a sheet shows the same
  list the desktop rail does, and the one thing the card genuinely did better —
  putting a headline in front of someone who never asked for one — is now the
  toolbar's ticker line, which costs 28px instead of 122 and needs no timer.
-->
<div
  id="news-feed-panel"
  data-initial-days={initialDays}
  class="mobile-sheet absolute top-0 bottom-0 right-0 left-auto z-30 pointer-events-auto font-sans bg-panel backdrop-blur-md border border-hair md:border-l md:border-t-0 md:border-r-0 md:border-b-0 rounded-2xl md:rounded-none shadow-2xl shadow-(color:--shadow-panel) md:w-96 flex flex-col overflow-hidden md:overflow-visible transition-transform duration-300 ease-out translate-x-0"
>
  <!--
    Header. Same navy band as the filter sidebar's masthead (see global.css), so
    the two rails are headed identically and the article list below reads as the
    portal's off-white body. Shown at every width now that the phone layout uses
    this same panel rather than a card of its own.
  -->
  <div
    class="band bg-panel flex items-center gap-2.5 px-4 py-3.5 border-b border-hair shrink-0"
  >
    <div
      class="flex items-center justify-center w-7 h-7 rounded-lg bg-hover shrink-0"
    >
      <Newspaper size={14} stroke-width={2} class="text-accent" />
    </div>
    <div class="min-w-0 flex-1">
      <h4
        class="text-[10px] font-bold text-ink mt-1 uppercase tracking-wider leading-none"
      >
        Related MN Coverage
      </h4>
    </div>
    <!--
      `data-sheet-close` is the toolbar's documented way to be asked to close
      the open sheet without this panel needing to know what a sheet is — see
      ~/lib/mobileSheet.ts. The scrim and the tab itself both close it too; this
      is the affordance that says so.
    -->
    <button
      type="button"
      data-sheet-close
      aria-label="Close news panel"
      class="md:hidden w-8 h-8 -mr-1 flex items-center justify-center rounded-full text-ink-3 active:bg-hover transition-colors shrink-0"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!--
    Date Range Selector. `.band-sub` is the portal's dark footer grey: a third
    surface between the navy header and the off-white list, which is what keeps
    the range pills reading as chrome rather than as the first article.

    Offered at every width again. These were hidden on phones because four 9px
    pills wedged into a 122px notification card were unhittable; in a sheet
    there is room to give them a real target height.
  -->
  <div
    id="nf-range-group"
    role="group"
    aria-label="News date range"
    class="band-sub bg-panel flex items-center gap-1.5 px-4 py-2.5 border-b border-hair shrink-0"
  >
    {
      RANGE_OPTIONS.map((opt) => (
        <button
          type="button"
          class="nf-range-btn text-[9px] font-bold uppercase tracking-wider px-3 min-h-8 md:min-h-0 md:py-1 rounded-full border transition-colors text-ink-4 border-hair hover:text-ink"
          data-days={opt.days}
          aria-pressed={opt.days === initialDays ? "true" : "false"}
        >
          {opt.label}
        </button>
      ))
    }
    <!--
      `aria-live`, because the skeleton below it is `aria-hidden` — it's four
      decorative boxes, and a screen reader should hear that the range is
      loading rather than nothing at all. This span already carried the visible
      "Loading…"; announcing it is what makes the two audiences equivalent.
    -->
    <span
      id="nf-range-status"
      role="status"
      aria-live="polite"
      class="text-[9px] text-ink-4 ml-auto uppercase tracking-wider"
    />
  </div>

  <div
    id="nf-content-area"
    class="overflow-y-auto p-4 space-y-4 hide-scrollbar flex-1 min-h-0"
  >
    {
      errorMessage ? (
        /*
          No-JS / build-time-failure rendering of the outage.

          Almost always unreachable: the payload behind this first paint is
          fetched at build time from CI, whose egress Google does answer, so the
          state a live reader hits is the client one in the template below. This
          exists for the case where the build itself couldn't reach Google, and
          for anyone without JS — which is why it carries no Retry button, that
          being the one part of the client state that can't work here.
        */
        <div class="flex flex-col gap-3">
          <div class="stat-well rounded-lg p-3 flex items-start gap-2.5" role="status">
            <span class="w-7 h-7 rounded-full bg-hover flex items-center justify-center shrink-0">
              <CloudOff size={14} class="text-ink-3" aria-hidden="true" />
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-[11px] font-semibold text-ink-2 leading-snug">
                {OUTAGE_TITLE}
              </p>
              <p class="mt-1 text-[10px] text-ink-4 leading-snug">{OUTAGE_BODY}</p>
            </div>
          </div>
          {/* Same static ghosts as the client template, so the two paths render
              one state. No Retry here — that is the one part of the client
              state that cannot work without JS. */}
          <div class="space-y-4 opacity-45" aria-hidden="true">
            {[0, 1, 2, 3].map(() => (
              <div class="border-b border-hair pb-3.5 last:border-0 last:pb-0">
                <div class="h-2 w-20 rounded bg-hover mb-2" />
                <div class="h-2.5 w-full rounded bg-hover mb-1.5" />
                <div class="h-2.5 w-4/5 rounded bg-hover mb-2.5" />
                <div class="h-2 w-16 rounded bg-hover" />
              </div>
            ))}
          </div>
        </div>
      ) : newsItems.length === 0 ? (
        <p class="text-ink-4 text-xs font-medium px-1">{EMPTY_NOTICE}</p>
      ) : (
        <Fragment>
          {notice && (
            <p class="text-[10px] text-ink-4 leading-snug px-1 pb-1 border-b border-hair">
              {notice}
            </p>
          )}
          {newsItems.map((item) => (
          <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
            <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-1">
              {item.source}
            </span>
            <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
            </h3>
            <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">
              {formatNewsDate(item.published)}
            </span>
          </article>
          ))}
        </Fragment>
      )
    }
  </div>

  <!--
    The three states the client swaps into #nf-content-area, authored here as
    templates rather than as HTML strings in the script.

    The script already builds one kind of markup by hand (`itemHTML`), and that
    is one too many: every class in a string is invisible to the Tailwind scan
    that decides which utilities get emitted, and invisible to the linter that
    keeps them canonical. These are real markup in a real component, so both
    tools see them, and the copy above has exactly one owner for the server's
    rendering and the client's alike.

    Slots the script fills, all optional:
      [data-nf-age]     how long ago the saved copy was fetched
      [data-nf-detail]  the upstream reason, behind a disclosure
  -->
  <template id="nf-tpl-skeleton">
    <!--
      Four rows, matching the shape of a real article — source, two title
      lines, date — so the panel keeps its rhythm while a range loads instead
      of collapsing to a single line of text and springing back.

      `aria-hidden` with a live-region label supplied by the script: a screen
      reader should hear "loading", not four rows of empty boxes.
    -->
    <div class="space-y-4 motion-safe:animate-pulse" aria-hidden="true">
      {
        [0, 1, 2, 3].map(() => (
          <div class="border-b border-hair pb-3.5 last:border-0 last:pb-0">
            <div class="h-2 w-20 rounded bg-hover mb-2" />
            <div class="h-2.5 w-full rounded bg-hover mb-1.5" />
            <div class="h-2.5 w-4/5 rounded bg-hover mb-2.5" />
            <div class="h-2 w-16 rounded bg-hover" />
          </div>
        ))
      }
    </div>
  </template>

  <template id="nf-tpl-stale">
    <!--
      Shown above headlines that are real but were fetched some time ago. It is
      a caveat on otherwise-good content, so it sits inline above the list at
      notice weight rather than replacing anything.
    -->
    <div
      class="stat-well rounded-lg p-2.5 flex items-start gap-2 mb-1"
      role="status"
    >
      <CloudOff size={12} class="text-ink-3 shrink-0 mt-px" aria-hidden="true" />
      <p class="text-[10px] text-ink-3 leading-snug flex-1 min-w-0">
        <!-- The prefix rides on the element the script fills rather than going
             through the JSON island, so every word of this sentence stays
             declared once, up in the frontmatter, next to the rest of the
             copy. -->
        {STALE_LEAD}<span data-nf-age data-prefix={STALE_AGE_PREFIX}></span>.
      </p>
      <button
        type="button"
        data-nf-retry
        class="text-[9px] font-bold uppercase tracking-wider text-accent hover:text-accent-hover shrink-0 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 rounded"
      >
        Retry
      </button>
    </div>
  </template>

  <!-- A genuinely quiet range, which is not an outage and must not look like
       one — the whole `ok` / `failed` distinction in ~/lib/newsFeed.ts exists
       to keep these two apart, and it would be undone by rendering them the
       same way here. -->
  <template id="nf-tpl-empty">
    <p class="text-ink-4 text-xs font-medium px-1">{EMPTY_NOTICE}</p>
  </template>

  <!--
    THE OUTAGE STATE, AS A SKELETON.

    It was a centred icon over two lines of text in an otherwise empty rail,
    which is the layout every "something went wrong" page uses and reads,
    correctly, as a dead end. This keeps the panel's own rhythm instead: the
    same four ghost article rows the loading state uses, so the rail still looks
    like a rail, with the explanation sitting on top of them rather than
    replacing everything.

    THE ONE THING THAT MUST NOT BE COPIED FROM THE LOADING SKELETON IS THE
    PULSE. `nf-tpl-skeleton` carries `motion-safe:animate-pulse`, and that
    animation is the whole signal that something is on its way. These rows are
    deliberately static, because nothing is on its way — the fetch has already
    failed and the only thing that will change it is the Retry below. A pulsing
    outage would be a spinner that never resolves, which is the same class of
    lie as the empty state claiming a quiet week.

    The ghosts are `aria-hidden`; the message above them is a `role="status"`,
    so a screen reader gets the sentence and not four empty boxes.
  -->
  <template id="nf-tpl-outage">
    <div class="flex flex-col gap-3">
      <div class="stat-well rounded-lg p-3 flex items-start gap-2.5" role="status">
        <span
          class="w-7 h-7 rounded-full bg-hover flex items-center justify-center shrink-0"
        >
          <CloudOff size={14} class="text-ink-3" aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-semibold text-ink-2 leading-snug">
            {OUTAGE_TITLE}
          </p>
          <p class="mt-1 text-[10px] text-ink-4 leading-snug">{OUTAGE_BODY}</p>

          <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <button
              type="button"
              data-nf-retry
              class="inline-flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-full border border-hair text-ink-3 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
            >
              <RefreshCw size={10} aria-hidden="true" />
              Try again
            </button>

            <!--
              The status code, kept and demoted. Someone debugging this
              genuinely wants "503" and a member of the public genuinely does
              not, and a disclosure is the one control that serves both without
              a second surface.
            -->
            <details class="min-w-0">
              <summary
                class="text-[9px] uppercase tracking-wider text-ink-4 hover:text-ink-3 cursor-pointer list-none focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 rounded"
              >
                Technical detail
              </summary>
              <p
                data-nf-detail
                class="text-[9px] text-ink-4 leading-snug pt-1.5 wrap-break-word"
              >
              </p>
            </details>
          </div>
        </div>
      </div>

      <!-- Static, not pulsing. See the note above — this is the whole point. -->
      <div class="space-y-4 opacity-45" aria-hidden="true">
        {
          [0, 1, 2, 3].map(() => (
            <div class="border-b border-hair pb-3.5 last:border-0 last:pb-0">
              <div class="h-2 w-20 rounded bg-hover mb-2" />
              <div class="h-2.5 w-full rounded bg-hover mb-1.5" />
              <div class="h-2.5 w-4/5 rounded bg-hover mb-2.5" />
              <div class="h-2 w-16 rounded bg-hover" />
            </div>
          ))
        }
      </div>
    </div>
  </template>

  <!-- Desktop pull-tab toggle -->
  <button
    id="nf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="news-feed-panel"
    aria-label="Toggle news feed panel"
    class="hidden md:flex absolute z-40 items-center justify-center bg-panel border border-hair border-r-0 text-ink-3 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50
           top-1/2 left-0 -translate-x-full -translate-y-1/2 w-8 h-12 rounded-l-xl"
  >
    <svg
      id="nf-toggle-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      class="transition-transform duration-300 ease-out"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M9 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script
  is:inline
  type="application/json"
  id="nf-initial-data"
  set:html={JSON.stringify({ newsItems, errorMessage, truncated, partial, stale, storedAt, notices: { cap: CAP_NOTICE, partial: PARTIAL_NOTICE } }).replace(/</g, "\\u003c")}
/>

<script>
  import { onReady } from "~/lib/domReady";
  import {
    byPublishedDesc,
    collapseDuplicates,
    formatCacheAge,
    formatNewsDate,
    type NewsItem,
    type NewsPayload,
  } from "~/lib/newsFeed";
  import { readStoredFlag, writeStoredFlag } from "~/lib/storage";
  import { onSheetChange, type SheetId } from "~/lib/mobileSheet";

  const STORAGE_KEY = "newsFeedCollapsed";
  const DESKTOP_MEDIA_QUERY = "(min-width: 768px)";
  const DAY_MS = 24 * 60 * 60 * 1000;

  let isMarkerSelected = false;
  /** Desktop only: the pull-tab's persisted state. */
  let isNewsCollapsed = false;
  /** Phone only: which sheet the toolbar says is open. */
  let openSheet: SheetId | null = null;
  let newsCleanups: (() => void)[] = [];
  let currentDays = 7;
  let desktopMql: MediaQueryList | null = null;

  /** Ceiling on one /api/news call — see the note at the fetch itself. */
  const NEWS_FETCH_TIMEOUT_MS = 12_000;

  // Every article ever fetched this session, keyed by normalized
  // title+source (see dedupeKey below) — not by url. Google News RSS
  // doesn't return consistent results across *differently scoped* queries
  // for the same underlying story: a `when:1d` query and a `when:7d`
  // query can report the same headline under two different Google
  // redirect URLs and two different published dates, and one is not
  // reliably a superset of the other in either direction. That means
  // every range still has to hit the network for itself (there is no way
  // to safely derive a narrower window's results by filtering a wider
  // window's cached response, or vice versa — an earlier version of this
  // file tried exactly that and silently dropped today's freshest article
  // from "24H" because the cached "7D" fetch never contained it), and
  // deduping by url would show that same story twice. What accumulating
  // fetched results into one title-keyed pool *does* still buy us: once
  // an article has been seen under any window, switching to a wider
  // window won't lose it or duplicate it just because that window's own
  // live query returned a different URL/date for the identical headline.
  let articleCache = new Map<string, NewsItem>();
  let lastFetchError: string | null = null;

  /**
   * When the items currently in the pool were fetched, ISO.
   *
   * Tracked across fetches rather than read per response, because the banner
   * that uses it appears exactly when the latest response has no date of its
   * own: the refresh failed, and what's on screen is whatever the last
   * *successful* one left behind. Overwritten only on success, so a run of
   * failures keeps dating the copy the reader is actually looking at.
   */
  let lastStoredAt: string | null = null;

  /**
   * Whether what's on screen is current.
   *
   * Separate from `lastFetchError` rather than folded into it, because the two
   * answer different questions and only one of them is a problem. A refresh can
   * fail outright, or it can succeed and hand back the route's own last-good
   * copy — both leave the reader looking at old headlines, which is what the
   * banner is about, but only the first is an error and only the first should
   * ever reach the outage state.
   */
  let degraded = false;

  // Google's per-query redirect URLs aren't a stable identity for "the
  // same story" (see note above), but a title from the same outlet is —
  // two truly distinct stories that happen to share a headline but come
  // from different outlets are still treated as separate entries.
  function dedupeKey(item: NewsItem): string {
    return `${item.title.trim().toLowerCase()}::${item.source.trim().toLowerCase()}`;
  }

  function mergeItems(items: NewsItem[]): void {
    for (const item of items) articleCache.set(dedupeKey(item), item);
  }

  function itemsWithinWindow(days: number): NewsItem[] {
    const cutoff = Date.now() - days * DAY_MS;
    return collapseDuplicates(
      Array.from(articleCache.values())
        .filter((item) => new Date(item.published).getTime() >= cutoff)
        .sort(byPublishedDesc),
    );
  }

  // Carried over from the server render rather than restated here, so the two
  // copies of these sentences can't drift apart.
  let notices = { cap: "", partial: "" };

  // Coverage is a property of the window being shown, not of the accumulated
  // pool, so it's tracked per window: switching from 1Y back to 7D has to drop
  // the caveat along with the year's extra articles.
  const windowNotice = new Map<number, "cap" | "partial">();

  type InitialPayload = NewsPayload & {
    notices?: { cap: string; partial: string };
  };

  function readInitialPayload(): InitialPayload {
    const el = document.getElementById("nf-initial-data");
    const empty: InitialPayload = {
      newsItems: [],
      errorMessage: null,
      truncated: false,
      partial: false,
      stale: false,
      storedAt: null,
    };
    if (!el?.textContent) return empty;
    try {
      return JSON.parse(el.textContent);
    } catch {
      return empty;
    }
  }

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function itemHTML(item: NewsItem): string {
    return `
      <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
        <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-1">${escapeHtml(item.source)}</span>
        <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
          <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title)}</a>
        </h3>
        <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">${formatNewsDate(item.published)}</span>
      </article>`;
  }

  /**
   * The toolbar's one-line ticker (MobileToolbar.astro).
   *
   * This is the whole of what the deleted mobile news card did that a tab
   * cannot: put a headline in front of someone who never went looking for one.
   * `textContent`, not innerHTML — the title is third-party RSS.
   *
   * Hidden whenever there is nothing to say, so an outage or an empty window
   * costs no height rather than showing an empty bar.
   */
  function renderTicker(newsItems: NewsItem[]): void {
    const ticker = document.getElementById("mt-ticker");
    const text = document.getElementById("mt-ticker-text");
    if (!ticker || !text) return;

    const lead = newsItems[0];
    if (!lead) {
      ticker.classList.add("hidden");
      ticker.classList.remove("flex");
      text.textContent = "";
      return;
    }
    text.textContent = lead.title;
    ticker.classList.remove("hidden");
    ticker.classList.add("flex");
  }

  /** Clone one of the state templates authored in the markup above. */
  function stateNode(id: string): DocumentFragment | null {
    const tpl = document.getElementById(id) as HTMLTemplateElement | null;
    return tpl ? (tpl.content.cloneNode(true) as DocumentFragment) : null;
  }

  /**
   * Replace the list with the loading skeleton.
   *
   * Only for an explicit range click. The refresh on mount is silent by design
   * (see `showRange`), and tearing down headlines someone is reading to show
   * them four grey boxes would undo the point of that.
   */
  function renderSkeleton(): void {
    const area = document.getElementById("nf-content-area");
    const node = stateNode("nf-tpl-skeleton");
    if (!area || !node) return;
    area.setAttribute("aria-busy", "true");
    area.replaceChildren(node);
  }

  /**
   * Render the list, plus whatever caveat applies to it.
   *
   * Three outcomes, and they are deliberately not the same shape:
   *
   *   items, live      the list, with the cap/partial notice if either applies
   *   items, stale     the same list under a banner dating it, because
   *                    headlines fetched hours ago are still true and still
   *                    worth reading — they just aren't news
   *   nothing at all   the outage state, which explains itself and offers a
   *                    retry rather than reporting a status code
   *
   * The middle one is the case this panel used to get wrong: a failed refresh
   * fell back to the pool and rendered it with no indication that it had, so
   * an outage looked exactly like a quiet afternoon.
   */
  function renderNews(newsItems: NewsItem[], errorMessage: string | null): void {
    const area = document.getElementById("nf-content-area");
    if (!area) return;
    area.removeAttribute("aria-busy");

    if (newsItems.length === 0) {
      const node = stateNode(errorMessage ? "nf-tpl-outage" : "nf-tpl-empty");
      if (node) {
        // `textContent`, so an upstream string can never reach the DOM as
        // markup. It originates in our own route, but it quotes Google.
        const detail = (node as DocumentFragment).querySelector("[data-nf-detail]");
        if (detail && errorMessage) detail.textContent = errorMessage;
        area.replaceChildren(node);
      }
      renderTicker([]);
      return;
    }

    const parts: Node[] = [];

    if (degraded) {
      const banner = stateNode("nf-tpl-stale");
      const age = formatCacheAge(lastStoredAt);
      if (banner) {
        const slot = banner.querySelector<HTMLElement>("[data-nf-age]");
        // The lead reads "…showing saved headlines", so the age is a suffix
        // and simply omitted when we can't date the copy — rather than the
        // sentence admitting it doesn't know, which helps nobody.
        if (slot) {
          slot.textContent = age ? `${slot.dataset.prefix ?? ""} ${age}` : "";
        }
        parts.push(banner);
      }
    }

    const kind = windowNotice.get(currentDays);
    const text = kind ? notices[kind] : "";
    if (text) {
      const p = document.createElement("p");
      p.className =
        "text-[10px] text-ink-4 leading-snug px-1 pb-1 border-b border-hair";
      p.textContent = text;
      parts.push(p);
    }

    const list = document.createElement("div");
    list.className = "space-y-4";
    list.innerHTML = newsItems.map(itemHTML).join("");
    parts.push(list);

    area.replaceChildren(...parts);
    renderTicker(newsItems);
  }

  // `bg-accent-soft`, not `bg-accent/10`: the campaign banner's chamber pills are
  // the same affordance (its comment says so) and use the token, so this had
  // drifted to a differently-mixed wash of the same colour.
  const PILL_ON = ["text-accent", "border-accent/30", "bg-accent-soft"];
  const PILL_OFF = ["text-ink-4", "border-hair"];

  function updateRangeButtons(root: HTMLElement): void {
    root.querySelectorAll<HTMLButtonElement>(".nf-range-btn").forEach((btn) => {
      const isActive = Number(btn.dataset.days) === currentDays;
      btn.setAttribute("aria-pressed", String(isActive));
      btn.classList.add(...(isActive ? PILL_ON : PILL_OFF));
      btn.classList.remove(...(isActive ? PILL_OFF : PILL_ON));
    });
  }

  /**
   * Fetch and render one window.
   *
   * `silent` is for the refresh on mount, where there is already server-rendered
   * content on screen: flashing "Loading…" over headlines the reader is halfway
   * through, to replace them with the same headlines, is worse than saying
   * nothing. A range *click* is an explicit request and does show progress.
   */
  async function showRange(
    root: HTMLElement,
    days: number,
    opts: { silent?: boolean } = {},
  ): Promise<void> {
    currentDays = days;
    updateRangeButtons(root);

    // Always fetch this window's own live results — a wider window's
    // cached response can't be trusted to contain everything a direct
    // query for `days` would (see the note on articleCache above).
    const status = document.getElementById("nf-range-status");
    if (status && !opts.silent) status.textContent = "Loading…";

    const buttons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    if (!opts.silent) {
      buttons.forEach((btn) => (btn.disabled = true));
      // The skeleton replaces the previous window's headlines, which is right
      // here and wrong on the silent mount refresh — those articles belong to
      // a range the reader has just navigated away from, so leaving them up
      // would show them results for a window they didn't ask for.
      renderSkeleton();
    }

    try {
      // Bounded, because the failure this guards against isn't a slow answer —
      // it's no answer. Every exit from this function that re-enables the range
      // buttons is in the `finally`, so a fetch that never settles leaves the
      // controls disabled and the panel reading "Loading…" for as long as the
      // tab is open. The route's own upstream budget is 8s per query (see
      // QUERY_BUDGET_MS in ~/lib/newsFeed.ts) and its queries run in parallel,
      // so this sits above a legitimately slow-but-working refresh rather than
      // cutting one off.
      const res = await fetch(`/api/news?days=${days}`, {
        signal: AbortSignal.timeout(NEWS_FETCH_TIMEOUT_MS),
      });
      if (!res.ok) throw new Error("Request failed");
      const data = (await res.json()) as NewsPayload;
      if (data.errorMessage) {
        lastFetchError = data.errorMessage;
        // Nothing live arrived, so whatever the pool renders from here is by
        // definition not current.
        degraded = true;
      } else {
        mergeItems(data.newsItems ?? []);
        lastFetchError = null;
        // A response the route served from its *own* last-good copy is still a
        // successful fetch — it just isn't live, and `stale` is how the route
        // says so. `storedAt` dates the copy in both cases.
        degraded = data.stale === true;
        if (data.storedAt) lastStoredAt = data.storedAt;
        // Recorded, not just read, because the pool this window renders from
        // accumulates across fetches: once 1Y has been shown to be cut off,
        // coming back to it later must still say so. The cap is stated ahead
        // of a failed segment when both apply — it's the permanent limit,
        // where the other clears on the next successful fetch.
        if (data.truncated) windowNotice.set(days, "cap");
        else if (data.partial) windowNotice.set(days, "partial");
        else windowNotice.delete(days);
      }
      // One call, and `lastFetchError` straight through — no fallback sentence
      // behind it, and no branch on whether the pool happens to hold anything.
      //
      // Both halves of that matter, and each fixes a way this panel used to lie
      // about which of three situations the reader is in.
      //
      // NO FALLBACK SENTENCE. `lastFetchError` is null exactly when the fetch
      // worked, and `renderNews` picks between the outage and the quiet-week
      // template on that argument alone. Substituting a stand-in string made
      // every genuinely empty range render as an outage — telling the reader
      // Google wasn't answering when it had answered and said there was
      // nothing. 24H hit that most, being the window most often legitimately
      // empty, and it left `nf-tpl-empty` unreachable.
      //
      // NO `articleCache.size` BRANCH. Passing `null` whenever the pool held
      // anything discarded the error even when this window's slice of that pool
      // came back empty — and the pool is a *session* accumulator while
      // `itemsWithinWindow` is a cutoff against the clock, so those two come
      // apart routinely. The case is not hypothetical: with Google refusing
      // this Worker's egress (a sustained 503 — see FAILURE_BACKOFF_SECONDS in
      // ~/pages/api/news.ts), the only content in the pool is the build-time
      // snapshot, and the moment that snapshot ages past the selected window
      // the panel rendered "No new local updates found." in the middle of a
      // total outage. Same lie as above, running the other way.
      //
      // `itemsWithinWindow` returns [] for an empty pool by construction, so
      // the guard was only ever choosing which argument to pass, never whether
      // to render. Let `renderNews` decide: it shows the list when there is
      // one — under the stale banner if `degraded` — and otherwise picks its
      // template from whether the fetch actually failed.
      renderNews(itemsWithinWindow(days), lastFetchError);
    } catch {
      // Reached by the abort above as well as by a network failure. The pool is
      // still the right thing to show if it has anything for this window; if it
      // does not, this is an outage and has to say so rather than falling
      // through to the quiet-week copy.
      degraded = true;
      renderNews(itemsWithinWindow(days), "Couldn't load news for that range.");
    } finally {
      buttons.forEach((btn) => (btn.disabled = false));
      if (status && !opts.silent) status.textContent = "";
    }
  }

  function initNewsFeed(): void {
    const root = document.getElementById("news-feed-panel");
    if (!root) return;

    while (newsCleanups.length > 0) {
      newsCleanups.pop()?.();
    }

    const parsedInitialDays = Number(root.dataset.initialDays);
    currentDays = Number.isNaN(parsedInitialDays) ? 7 : parsedInitialDays;

    // Retry, delegated to the content area rather than bound to the buttons.
    // Both live inside markup that `renderNews` replaces wholesale, so a direct
    // listener would be attached to a node that is thrown away the first time
    // it is used — and re-binding after every render is the bookkeeping this
    // avoids. The listener outlives the buttons because the container does.
    const contentArea = document.getElementById("nf-content-area");
    const onRetryClick = (event: Event) => {
      const trigger = (event.target as HTMLElement | null)?.closest(
        "[data-nf-retry]",
      );
      if (!trigger) return;
      // Not silent: this is the most explicit request there is, and it must
      // show that something happened even if it fails the same way again.
      void showRange(root, currentDays);
    };
    contentArea?.addEventListener("click", onRetryClick);
    newsCleanups.push(() =>
      contentArea?.removeEventListener("click", onRetryClick),
    );

    // Seed the shared pool with whatever the server already fetched for
    // the initial (default) range, so it's not lost if the user switches
    // away and back.
    articleCache = new Map();
    lastFetchError = null;
    degraded = false;
    lastStoredAt = null;
    windowNotice.clear();
    const initialPayload = readInitialPayload();
    notices = initialPayload.notices ?? { cap: "", partial: "" };
    if (initialPayload.errorMessage) {
      lastFetchError = initialPayload.errorMessage;
    } else {
      mergeItems(initialPayload.newsItems);
      // Dates the build-time snapshot. If the refresh below then fails, this is
      // what the banner reports — and on a site deployed days ago that is
      // exactly the number a reader needs to see.
      lastStoredAt = initialPayload.storedAt;
      if (initialPayload.truncated) windowNotice.set(currentDays, "cap");
      else if (initialPayload.partial)
        windowNotice.set(currentDays, "partial");
    }
    renderTicker(
      initialPayload.errorMessage ? [] : initialPayload.newsItems,
    );

    const toggleBtn = document.getElementById(
      "nf-toggle",
    ) as HTMLButtonElement | null;
    const toggleIcon = document.getElementById(
      "nf-toggle-icon",
    ) as SVGElement | null;

    const rangeButtons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    rangeButtons.forEach((btn) => {
      const onClick = () => {
        const days = Number(btn.dataset.days);
        if (!Number.isNaN(days) && days !== currentDays) {
          showRange(root, days);
        }
      };
      btn.addEventListener("click", onClick);
      newsCleanups.push(() => btn.removeEventListener("click", onClick));
    });
    updateRangeButtons(root);

    desktopMql = window.matchMedia(DESKTOP_MEDIA_QUERY);

    isMarkerSelected = false;
    isNewsCollapsed = readStoredFlag(STORAGE_KEY);
    openSheet = null;

    /**
     * Keeps the map's control stack clear of the right-hand rail.
     *
     * MapLibre's zoom buttons, its attribution, and MapThemeSelector.astro's
     * layers button all anchor to --map-ctrl-right (see global.css), which was
     * a flat 10px — the map container's own right edge. This panel is docked to
     * that same edge at `md:w-96` and sits above them at z-30, so with the news
     * rail showing, which is its default, every one of those controls was
     * underneath it: not merely hard to see but unclickable, at every desktop
     * width. Collapsing the rail was the only way to reach the basemap picker
     * or the zoom buttons, and nothing said so.
     *
     * Written from here, and only here, because this island is the one that
     * knows whether the corner is occupied: it tracks its own collapsed state
     * *and* the marker selection that slides the facility panel — the same
     * width — into the same edge. A second writer would be the two-owners
     * problem MobileToolbar.astro's --map-controls-bottom note describes.
     */
    function publishControlEdge(occupied: boolean): void {
      const style = document.documentElement.style;
      if (occupied) {
        style.setProperty(
          "--map-ctrl-right",
          "calc(var(--map-rail-w) + var(--map-ctrl-edge))",
        );
      } else {
        style.removeProperty("--map-ctrl-right");
      }
    }

    function updatePanelDOM(): void {
      // On a phone this panel is one of three that share a slot, and the
      // toolbar decides which. `hidden` beats the `flex` in the class list
      // above (Tailwind emits it later in the utilities layer), which is the
      // same mechanism the facility panel uses.
      if (!desktopMql!.matches) {
        root!.classList.toggle("hidden", openSheet !== "news");
        toggleBtn?.classList.add("hidden");
        // A sheet docks to the bottom edge above the toolbar, not to the right
        // one, so the corner is the map's again.
        publishControlEdge(false);
        return;
      }

      // Either surface holds the right edge at the same width — see
      // `publishControlEdge`.
      publishControlEdge(isMarkerSelected || !isNewsCollapsed);

      // Desktop owns its own visibility again; anything the phone layout put
      // on this element has to come back off, or the rail stays gone at a
      // width where nothing can bring it back.
      root!.classList.remove("hidden");

      if (isMarkerSelected) {
        root!.classList.add("translate-x-full");
        root!.classList.remove("translate-x-0");
        toggleBtn?.classList.add("hidden");
      } else {
        toggleBtn?.classList.remove("hidden");
        if (isNewsCollapsed) {
          root!.classList.add("translate-x-full");
          root!.classList.remove("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "false");
          if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
        } else {
          root!.classList.remove("translate-x-full");
          root!.classList.add("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "true");
          if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
        }
      }
    }

    /** Desktop pull-tab. Persisted, because a rail someone slid shut should
     *  stay shut — and it can always be slid back open. */
    const onToggleClick = () => {
      isNewsCollapsed = !isNewsCollapsed;
      writeStoredFlag(STORAGE_KEY, isNewsCollapsed);
      updatePanelDOM();
    };
    toggleBtn?.addEventListener("click", onToggleClick);
    newsCleanups.push(() =>
      toggleBtn?.removeEventListener("click", onToggleClick),
    );

    const onMarkerSelect = (event: Event) => {
      const detail = (
        event as CustomEvent<{ project: unknown } | null>
      ).detail;
      isMarkerSelected = !!detail?.project;
      updatePanelDOM();
    };
    document.addEventListener("mapmarkerselect", onMarkerSelect);
    newsCleanups.push(() =>
      document.removeEventListener("mapmarkerselect", onMarkerSelect),
    );

    newsCleanups.push(
      onSheetChange((open) => {
        openSheet = open;
        updatePanelDOM();
      }),
    );

    const onMediaChange = () => updatePanelDOM();
    desktopMql.addEventListener("change", onMediaChange);
    newsCleanups.push(() =>
      desktopMql!.removeEventListener("change", onMediaChange),
    );

    updatePanelDOM();

    // Refresh from the live route on mount.
    //
    // This is what makes the scheduled full-site rebuild unnecessary. The
    // markup above is a build-time snapshot — it paints instantly and works
    // without JS, but it's frozen at deploy time, and refreshing it was the
    // only job of the six-hourly cron. /api/news answers the same query live
    // and is cached server-side per window, so one fetch serves every visitor
    // in that window and the panel is never older than its freshness period.
    //
    // Silent when there's already something on screen: the common case is that
    // live results match the snapshot, and a visible reload for no visible
    // change is just noise.
    const hasPaintedItems =
      !initialPayload.errorMessage && initialPayload.newsItems.length > 0;
    void showRange(root, currentDays, { silent: hasPaintedItems });
  }

  onReady(initNewsFeed);
</script>
